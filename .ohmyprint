# GCR terminal UI helpers.
#
# Two layers live in this file:
#   ui_*     the primitives every GCR screen is built from
#   print_*  the older helpers, kept for compatibility and drawn with the same palette
#
# Sourced by .ohmyshell, so it must stay quiet at load time and work in bash and zsh.

# ------------------------------------------------------------------ palette ---

# True when this shell still has a controlling terminal. Checked instead of
# [ -t 1 ] alone because p10k instant prompt redirects stdout while .ohmyshell
# is being sourced, which would otherwise strip every color for the session.
ui_has_tty() {
    if [ -t 1 ]; then
        return 0
    fi
    ( : < /dev/tty ) 2>/dev/null
}

# True only when it is safe to redraw in place: cursor moves need a real stdout.
ui_interactive() {
    [ -t 1 ] && [ "${TERM:-}" != "dumb" ] && ( : < /dev/tty ) 2>/dev/null
}

ui_cols() {
    local cols=$(tput cols 2>/dev/null)
    case "$cols" in
        ''|*[!0-9]*) cols=80 ;;
    esac
    printf '%s' "$cols"
}

ui_rows() {
    local rows=$(tput lines 2>/dev/null)
    case "$rows" in
        ''|*[!0-9]*) rows=24 ;;
    esac
    printf '%s' "$rows"
}

# ui_fit <text> <width> -> UI_FIT, the text cut to the width with an ellipsis.
ui_fit() {
    local keep
    UI_FIT="$1"
    if [ "$2" -le 0 ]; then
        UI_FIT=""
    elif [ "${#1}" -gt "$2" ]; then
        keep=$(($2 - ${#UI_G_ELLIPSIS}))
        if [ "$keep" -lt 1 ]; then
            keep=1
        fi
        UI_FIT="${1:0:$keep}${UI_G_ELLIPSIS}"
    fi
}

ui_init() {
    UI_TTY=0
    if ui_has_tty && [ "${TERM:-}" != "dumb" ]; then
        UI_TTY=1
    fi

    UI_COLOR=0
    if [ "$UI_TTY" = 1 ] && [ -z "${NO_COLOR:-}" ]; then
        UI_COLOR=1
    fi

    UI_ESC=$(printf '\033')
    UI_CR=$(printf '\r')
    UI_LF='
'

    UI_TRUECOLOR=0
    case "${COLORTERM:-}" in
        truecolor|24bit) UI_TRUECOLOR=1 ;;
    esac

    if [ "$UI_COLOR" = 1 ]; then
        if [ "$UI_TRUECOLOR" = 1 ]; then
            # 24-bit TrueColor
            UI_ACCENT="${UI_ESC}[38;2;56;189;248m"   # Sky blue (#38bdf8)
            UI_OK="${UI_ESC}[38;2;52;211;153m"       # Emerald green (#34d399)
            UI_WARN="${UI_ESC}[38;2;251;191;36m"     # Warm amber (#fbbf24)
            UI_ERR="${UI_ESC}[38;2;248;113;113m"     # Coral red (#f87171)
            UI_PURPLE="${UI_ESC}[38;2;167;139;250m"  # Soft purple (#a78bfa)
            UI_CYAN="${UI_ESC}[38;2;34;211;238m"     # Electric cyan (#22d3ee)
            UI_MUTED="${UI_ESC}[38;2;148;163;184m"   # Slate gray (#94a3b8)
            UI_SEL_BG="${UI_ESC}[48;2;30;41;59m"     # Dark slate bg (#1e293b)
        else
            case "$(tput colors 2>/dev/null || echo 8)" in
                *[0-9][0-9][0-9]*)
                    # 256 colors
                    UI_ACCENT="${UI_ESC}[38;5;39m"
                    UI_OK="${UI_ESC}[38;5;42m"
                    UI_WARN="${UI_ESC}[38;5;214m"
                    UI_ERR="${UI_ESC}[38;5;203m"
                    UI_PURPLE="${UI_ESC}[38;5;141m"
                    UI_CYAN="${UI_ESC}[38;5;51m"
                    UI_MUTED="${UI_ESC}[38;5;245m"
                    UI_SEL_BG="${UI_ESC}[48;5;236m"
                    ;;
                *)
                    # Basic 8/16 colors
                    UI_ACCENT="${UI_ESC}[36m"
                    UI_OK="${UI_ESC}[32m"
                    UI_WARN="${UI_ESC}[33m"
                    UI_ERR="${UI_ESC}[31m"
                    UI_PURPLE="${UI_ESC}[35m"
                    UI_CYAN="${UI_ESC}[36m"
                    UI_MUTED="${UI_ESC}[2m"
                    UI_SEL_BG=""
                    ;;
            esac
        fi
        UI_RESET="${UI_ESC}[0m"
        UI_BOLD="${UI_ESC}[1m"
        UI_DIM="${UI_ESC}[2m"
        UI_ITALIC="${UI_ESC}[3m"
        UI_UNDER="${UI_ESC}[4m"
        UI_REVERSE="${UI_ESC}[7m"
    else
        UI_ACCENT=""
        UI_OK=""
        UI_WARN=""
        UI_ERR=""
        UI_PURPLE=""
        UI_CYAN=""
        UI_MUTED=""
        UI_SEL_BG=""
        UI_RESET=""
        UI_BOLD=""
        UI_DIM=""
        UI_ITALIC=""
        UI_UNDER=""
        UI_REVERSE=""
    fi

    UI_HIDE="${UI_ESC}[?25l"
    UI_SHOW="${UI_ESC}[?25h"
    UI_CLR="${UI_ESC}[K"
    UI_CLR_BELOW="${UI_ESC}[J"
    UI_DEL=$(printf '\177')
    UI_BS=$(printf '\b')
    UI_TAB=$(printf '\t')
    UI_INT=$(printf '\003')

    # How long to wait for the rest of an escape sequence: an arrow key arrives
    # whole, a bare escape is reported after this. zsh reads with a timeout in
    # seconds, bash sets the terminal read timer in tenths of a second.
    UI_KEY_WAIT=0.05
    UI_KEY_WAIT_DS=1

    UI_UNICODE=0
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
        *UTF-8*|*utf-8*|*UTF8*|*utf8*) UI_UNICODE=1 ;;
    esac
    case "${TERM_PROGRAM:-}" in
        Apple_Terminal|iTerm.app|vscode|WezTerm|ghostty|Alacritty|kitty) UI_UNICODE=1 ;;
    esac

    if [ "$UI_UNICODE" = 1 ]; then
        UI_G_OK="✓"
        UI_G_ERR="✗"
        UI_G_WARN="▲"
        UI_G_INFO="✦"
        UI_G_DOT="·"
        UI_G_POINT="›"
        UI_G_POINTER="❯"
        UI_G_RADIO_ON="◉"
        UI_G_RADIO_OFF="◯"
        UI_G_ARROW="→"
        UI_G_UP="↑"
        UI_G_DOWN="↓"
        UI_G_RULE="─"
        UI_G_BLOCK="█"
        UI_G_BOX_TL="╭"
        UI_G_BOX_TR="╮"
        UI_G_BOX_BL="╰"
        UI_G_BOX_BR="╯"
        UI_G_BOX_H="─"
        UI_G_BOX_V="│"
        UI_G_BAR_FILL="█"
        UI_G_BAR_EMPTY="░"
        UI_G_CHECK_ON="◼"
        UI_G_CHECK_OFF="◻"
        UI_G_ELLIPSIS="…"
    else
        UI_G_OK="ok"
        UI_G_ERR="x"
        UI_G_WARN="!"
        UI_G_INFO="*"
        UI_G_DOT="-"
        UI_G_POINT=">"
        UI_G_POINTER=">"
        UI_G_RADIO_ON="[*]"
        UI_G_RADIO_OFF="[ ]"
        UI_G_ARROW="->"
        UI_G_UP="^"
        UI_G_DOWN="v"
        UI_G_RULE="-"
        UI_G_BLOCK="#"
        UI_G_BOX_TL="+"
        UI_G_BOX_TR="+"
        UI_G_BOX_BL="+"
        UI_G_BOX_BR="+"
        UI_G_BOX_H="-"
        UI_G_BOX_V="|"
        UI_G_BAR_FILL="#"
        UI_G_BAR_EMPTY="-"
        UI_G_CHECK_ON="[x]"
        UI_G_CHECK_OFF="[ ]"
        UI_G_ELLIPSIS="..."
    fi

    UI_FRACSLEEP=0
    if sleep 0.01 2>/dev/null; then
        UI_FRACSLEEP=1
    fi

    GCR_ANIM=0
    if [ "$UI_TTY" = 1 ] && [ "$UI_FRACSLEEP" = 1 ] && [ "${GCR_NO_ANIM:-0}" != 1 ]; then
        GCR_ANIM=1
    fi

    UI_COLS=$(ui_cols)
}

ui_init

# ------------------------------------------------------------------ output ---

ui_gap() {
    printf '\n'
}

# ui_heading <title> [subtitle]
ui_heading() {
    printf '\n  %s%s%s%s' "$UI_BOLD" "$UI_ACCENT" "$1" "$UI_RESET"
    if [ -n "${2:-}" ]; then
        printf '  %s%s%s' "$UI_MUTED" "$2" "$UI_RESET"
    fi
    printf '\n\n'
}

ui_rule() {
    local width=${1:-$(ui_cols)}
    local line="" i=0
    while [ "$i" -lt "$width" ]; do
        line="${line}${UI_G_RULE}"
        i=$((i + 1))
    done
    printf '%s%s%s\n' "$UI_MUTED" "$line" "$UI_RESET"
}

ui_ok() {
    printf '  %s%s%s %s\n' "$UI_OK" "$UI_G_OK" "$UI_RESET" "$1"
}

ui_warn() {
    printf '  %s%s%s %s\n' "$UI_WARN" "$UI_G_WARN" "$UI_RESET" "$1"
}

ui_err() {
    printf '  %s%s%s %s\n' "$UI_ERR" "$UI_G_ERR" "$UI_RESET" "$1"
}

ui_info() {
    printf '  %s%s%s %s\n' "$UI_ACCENT" "$UI_G_ARROW" "$UI_RESET" "$1"
}

ui_note() {
    printf '  %s%s%s\n' "$UI_MUTED" "$1" "$UI_RESET"
}

# ui_item <name> <description> [name column width]
ui_item() {
    local width=${3:-16}
    local name="$1" desc="$2"
    local pad=$((width - ${#name}))
    local spaces="  "
    if [ "$pad" -gt 0 ]; then
        spaces=$(printf '%*s' "$pad" "")
    fi
    printf "  %s%s%s%s  %s%s%s\n" \
        "$UI_ACCENT" "$name" "$UI_RESET" "$spaces" "$UI_MUTED" "$desc" "$UI_RESET"
}

# ui_field <label> <value> [label width]
ui_field() {
    local width=${3:-12}
    printf '  %s%-*s%s %s\n' "$UI_MUTED" "$width" "$1" "$UI_RESET" "$2"
}

# ui_command <command line>
ui_command() {
    printf '    %s%s%s %s%s%s\n' "$UI_MUTED" "$" "$UI_RESET" "$UI_ACCENT" "$1" "$UI_RESET"
}

# ui_step <label>, later closed by ui_step_ok or ui_step_err
ui_step() {
    printf '  %s%s%s %s%s%s' "$UI_MUTED" "$UI_G_DOT" "$UI_RESET" "$UI_MUTED" "$1" "$UI_RESET"
}

ui_step_ok() {
    printf '\r%s' "$UI_CLR"
    ui_ok "$1"
}

ui_step_err() {
    printf '\r%s' "$UI_CLR"
    ui_err "$1"
}

# Spinner frames, one per tick, cycling through four accent colors. Runs until
# the process in $2 exits, or forever when no pid is given.
ui_spin_frames() {
    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions shwordsplit
    fi
    local label="$1" pid="${2:-}" frames f i=0 color
    if [ "$UI_UNICODE" = 1 ]; then
        frames="⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏"
    else
        frames="/ - \\ |"
    fi
    while :; do
        for f in $frames; do
            if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
                return 0
            fi
            case $((i % 4)) in
                0) color="$UI_CYAN" ;;
                1) color="$UI_ACCENT" ;;
                2) color="$UI_PURPLE" ;;
                3) color="$UI_OK" ;;
            esac
            printf '\r%s  %s%s%s %s%s%s' "$UI_CLR" "$color" "$f" "$UI_RESET" "$UI_MUTED" "$label" "$UI_RESET"
            i=$((i + 1))
            sleep 0.05 2>/dev/null || sleep 1
        done
    done
}

# ui_spin <label> <command...>
# Runs the command behind a spinner and closes the line with ok or failure.
# The command output is discarded. Without a terminal it degrades to
# ui_step / ui_step_ok. Interactive shells announce background jobs, so the
# job is started quietly: zsh with monitor off, bash disowned.
ui_spin() {
    local label="$1"
    shift
    local cmd="$*"

    if [ "${GCR_ANIM:-0}" != 1 ] || ! ui_interactive; then
        ui_step "$label"
        if eval "$cmd" >/dev/null 2>&1; then
            ui_step_ok "$label"
            return 0
        else
            ui_step_err "$label"
            return 1
        fi
    fi

    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions nomonitor nonotify
    fi

    local tmp_out tmp_status pid cmd_status
    tmp_out=$(mktemp 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}/gcr_spin_$$")
    tmp_status="$tmp_out.status"
    { ( eval "$cmd" ) >"$tmp_out" 2>&1; printf '%s' "$?" >"$tmp_status"; } &
    pid=$!
    if [ -z "${ZSH_VERSION:-}" ]; then
        disown "$pid" 2>/dev/null
    fi

    trap 'printf "%s" "$UI_SHOW"; kill "$pid" 2>/dev/null; command rm -f "$tmp_out" "$tmp_status"; trap - INT TERM; return 130' INT TERM

    printf '%s' "$UI_HIDE"
    ui_spin_frames "$label" "$pid"
    if [ -n "${ZSH_VERSION:-}" ]; then
        wait "$pid" 2>/dev/null
    fi
    cmd_status=$(cat "$tmp_status" 2>/dev/null)
    case "$cmd_status" in
        ''|*[!0-9]*) cmd_status=1 ;;
    esac
    trap - INT TERM
    printf '%s' "$UI_SHOW"
    command rm -f "$tmp_out" "$tmp_status"

    if [ "$cmd_status" -eq 0 ]; then
        ui_step_ok "$label"
        return 0
    else
        ui_step_err "$label"
        return "$cmd_status"
    fi
}

# ui_spin_start <label>
# Spins next to the label while the caller keeps working in the foreground,
# so the work can set shell variables. Close it with ui_spin_stop. Ctrl-C in
# between stops the spinner and returns from the caller.
ui_spin_start() {
    UI_SPIN_LABEL="$1"
    UI_SPIN_PID=""
    if [ "${GCR_ANIM:-0}" != 1 ] || ! ui_interactive; then
        ui_step "$1"
        return 0
    fi
    printf '%s' "$UI_HIDE"
    if [ -n "${ZSH_VERSION:-}" ]; then
        eval 'ui_spin_frames "$UI_SPIN_LABEL" &!'
        UI_SPIN_PID=$!
    else
        ui_spin_frames "$UI_SPIN_LABEL" &
        UI_SPIN_PID=$!
        disown "$UI_SPIN_PID" 2>/dev/null
    fi
    trap 'ui_spin_kill; printf "\r%s%s" "$UI_CLR" "$UI_SHOW"; trap - INT TERM; return 130' INT TERM
}

ui_spin_kill() {
    local tries=0
    if [ -z "${UI_SPIN_PID:-}" ]; then
        return 0
    fi
    kill "$UI_SPIN_PID" 2>/dev/null
    while [ "$tries" -lt 20 ] && kill -0 "$UI_SPIN_PID" 2>/dev/null; do
        sleep 0.01 2>/dev/null || break
        tries=$((tries + 1))
    done
    UI_SPIN_PID=""
}

# ui_spin_stop <ok|err|clear> [label]
# ok and err close the line like ui_step_ok / ui_step_err, clear wipes the
# line so the caller can print its own result in its place.
ui_spin_stop() {
    local state="${1:-ok}" label="${2:-$UI_SPIN_LABEL}"
    if [ -n "${UI_SPIN_PID:-}" ]; then
        ui_spin_kill
        trap - INT TERM
        printf '%s' "$UI_SHOW"
    fi
    case "$state" in
        ok)  ui_step_ok "$label" ;;
        err) ui_step_err "$label" ;;
        *)   printf '\r%s' "$UI_CLR" ;;
    esac
}

# ui_badge <type: ok|warn|err|info|purple|muted> <text>
ui_badge() {
    local type="$1" text="$2" fg=""
    case "$type" in
        ok|success)   fg="$UI_OK" ;;
        warn|warning) fg="$UI_WARN" ;;
        err|error)    fg="$UI_ERR" ;;
        info)         fg="$UI_ACCENT" ;;
        purple)       fg="$UI_PURPLE" ;;
        cyan)         fg="$UI_CYAN" ;;
        *)            fg="$UI_MUTED" ;;
    esac
    printf '%s[%s]%s' "$fg" "$text" "$UI_RESET"
}

# ui_card <title> [subtitle] <lines...>
# Renders a sleek rounded bordered card
ui_card() {
    local title="$1" subtitle="${2:-}"
    shift 2
    local width=$((UI_COLS - 4))
    if [ "$width" -gt 74 ]; then width=74; fi
    if [ "$width" -lt 36 ]; then width=36; fi

    local header=" $title "
    if [ -n "$subtitle" ]; then
        header=" $title  $subtitle "
    fi
    local hlen=${#header}
    local rem=$((width - hlen - 3))
    if [ "$rem" -lt 1 ]; then rem=1; fi

    local hr="" i=0
    while [ "$i" -lt "$rem" ]; do
        hr="${hr}${UI_G_BOX_H}"
        i=$((i + 1))
    done

    printf '  %s%s%s%s%s%s%s%s%s\n' \
        "$UI_MUTED" "$UI_G_BOX_TL" "$UI_G_BOX_H" "$UI_RESET" \
        "$UI_BOLD$UI_ACCENT" "$header" "$UI_RESET" \
        "$UI_MUTED" "$hr$UI_G_BOX_TR" "$UI_RESET"

    local line
    for line in "$@"; do
        printf '  %s%s%s  %s\n' "$UI_MUTED" "$UI_G_BOX_V" "$UI_RESET" "$line"
    done

    local bot="" i=0
    local bot_len=$((width - 2))
    while [ "$i" -lt "$bot_len" ]; do
        bot="${bot}${UI_G_BOX_H}"
        i=$((i + 1))
    done
    printf '  %s%s%s%s%s\n' \
        "$UI_MUTED" "$UI_G_BOX_BL" "$bot" "$UI_G_BOX_BR" "$UI_RESET"
}

# ui_progress <current> <total> [width] [label]
ui_progress() {
    local cur=$1 tot=$2 w=${3:-24} lbl="${4:-}"
    if [ "$tot" -le 0 ]; then tot=1; fi
    local pct=$(( (cur * 100) / tot ))
    if [ "$pct" -gt 100 ]; then pct=100; fi
    local filled=$(( (cur * w) / tot ))
    if [ "$filled" -gt "$w" ]; then filled=$w; fi
    local empty=$((w - filled))

    local bar_f="" bar_e="" i=0
    while [ "$i" -lt "$filled" ]; do bar_f="${bar_f}${UI_G_BAR_FILL}"; i=$((i + 1)); done
    i=0
    while [ "$i" -lt "$empty" ]; do bar_e="${bar_e}${UI_G_BAR_EMPTY}"; i=$((i + 1)); done

    printf '  %s[%s%s%s%s] %s%3d%%%s (%d/%d)' \
        "$UI_MUTED" "$UI_ACCENT" "$bar_f" "$UI_MUTED" "$bar_e" \
        "$UI_BOLD" "$pct" "$UI_RESET" "$cur" "$tot"
    if [ -n "$lbl" ]; then
        printf '  %s%s%s' "$UI_MUTED" "$lbl" "$UI_RESET"
    fi
    printf '\n'
}

# ui_progress_anim <current> <total> [width] [label]
# In-place updating progress bar for smooth dynamic progress
ui_progress_anim() {
    local cur=$1 tot=$2 w=${3:-24} lbl="${4:-}"
    if [ "$tot" -le 0 ]; then tot=1; fi
    local pct=$(( (cur * 100) / tot ))
    if [ "$pct" -gt 100 ]; then pct=100; fi
    local filled=$(( (cur * w) / tot ))
    if [ "$filled" -gt "$w" ]; then filled=$w; fi
    local empty=$((w - filled))

    local bar_f="" bar_e="" i=0
    while [ "$i" -lt "$filled" ]; do bar_f="${bar_f}${UI_G_BAR_FILL}"; i=$((i + 1)); done
    i=0
    while [ "$i" -lt "$empty" ]; do bar_e="${bar_e}${UI_G_BAR_EMPTY}"; i=$((i + 1)); done

    if [ "${GCR_ANIM:-0}" = 1 ] && ui_interactive; then
        printf '\r%s  %s[%s%s%s%s] %s%3d%%%s (%d/%d)' \
            "$UI_CLR" \
            "$UI_MUTED" "$UI_ACCENT" "$bar_f" "$UI_MUTED" "$bar_e" \
            "$UI_BOLD" "$pct" "$UI_RESET" "$cur" "$tot"
        if [ -n "$lbl" ]; then
            printf '  %s%s%s' "$UI_MUTED" "$lbl" "$UI_RESET"
        fi
        if [ "$cur" -ge "$tot" ]; then
            printf '\n'
        fi
    else
        ui_progress "$cur" "$tot" "$w" "$lbl"
    fi
}

# ------------------------------------------------------------------- logo ---

ui_logo_row() {
    case "$1" in
        0) UI_LOGO_BITS="01110011101110" ;;
        1) UI_LOGO_BITS="10000100001001" ;;
        2) UI_LOGO_BITS="10110100001110" ;;
        3) UI_LOGO_BITS="10010100001010" ;;
        *) UI_LOGO_BITS="01110011101001" ;;
    esac
}

ui_logo_color() {
    if [ "$UI_COLOR" = 0 ]; then
        UI_LOGO_C=""
    elif [ "$UI_TRUECOLOR" = 1 ]; then
        case "$1" in
            0|1)   UI_LOGO_C="${UI_ESC}[38;2;56;189;248m" ;;
            2|3)   UI_LOGO_C="${UI_ESC}[38;2;59;130;246m" ;;
            4|5)   UI_LOGO_C="${UI_ESC}[38;2;96;165;250m" ;;
            6|7)   UI_LOGO_C="${UI_ESC}[38;2;129;140;248m" ;;
            8|9)   UI_LOGO_C="${UI_ESC}[38;2;147;197;253m" ;;
            10|11) UI_LOGO_C="${UI_ESC}[38;2;165;180;252m" ;;
            *)     UI_LOGO_C="${UI_ESC}[38;2;199;210;254m" ;;
        esac
    elif [ "$1" -lt 4 ]; then
        UI_LOGO_C="${UI_ESC}[38;5;39m"
    elif [ "$1" -lt 9 ]; then
        UI_LOGO_C="${UI_ESC}[38;5;75m"
    else
        UI_LOGO_C="${UI_ESC}[38;5;111m"
    fi
}

ui_logo() {
    local y=0 x bits bit line
    while [ "$y" -lt 5 ]; do
        ui_logo_row "$y"
        bits="$UI_LOGO_BITS"
        line="  "
        x=0
        while [ "$x" -lt 14 ]; do
            bit=${bits%"${bits#?}"}
            bits=${bits#?}
            if [ "$bit" = 1 ]; then
                ui_logo_color "$x"
                line="${line}${UI_LOGO_C}${UI_G_BLOCK}${UI_G_BLOCK}"
            else
                line="${line}  "
            fi
            x=$((x + 1))
        done
        printf '%s%s\n' "$line" "$UI_RESET"
        y=$((y + 1))
    done
}

# ui_logo_shine: dynamic light sweep across the GCR logo
ui_logo_shine() {
    if [ "${GCR_ANIM:-0}" != 1 ] || ! ui_interactive; then
        ui_logo
        return 0
    fi

    printf '%s' "$UI_HIDE"
    trap 'printf "%s" "$UI_SHOW"; trap - INT TERM; return 130' INT TERM
    local head=0 y bits bit line x
    while [ "$head" -lt 16 ]; do
        y=0
        while [ "$y" -lt 5 ]; do
            ui_logo_row "$y"
            bits="$UI_LOGO_BITS"
            line="  "
            x=0
            while [ "$x" -lt 14 ]; do
                bit=${bits%"${bits#?}"}
                bits=${bits#?}
                if [ "$bit" = 1 ]; then
                    if [ "$x" -eq "$head" ]; then
                        if [ "$UI_TRUECOLOR" = 1 ]; then
                            line="${line}${UI_ESC}[38;2;255;255;255m${UI_G_BLOCK}${UI_G_BLOCK}"
                        else
                            line="${line}${UI_ESC}[38;5;231m${UI_G_BLOCK}${UI_G_BLOCK}"
                        fi
                    elif [ "$x" -eq $((head - 1)) ] || [ "$x" -eq $((head + 1)) ]; then
                        if [ "$UI_TRUECOLOR" = 1 ]; then
                            line="${line}${UI_ESC}[38;2;147;197;253m${UI_G_BLOCK}${UI_G_BLOCK}"
                        else
                            line="${line}${UI_ESC}[38;5;153m${UI_G_BLOCK}${UI_G_BLOCK}"
                        fi
                    else
                        ui_logo_color "$x"
                        line="${line}${UI_LOGO_C}${UI_G_BLOCK}${UI_G_BLOCK}"
                    fi
                else
                    line="${line}  "
                fi
                x=$((x + 1))
            done
            printf '%s%s\n' "$line" "$UI_RESET"
            y=$((y + 1))
        done
        sleep 0.012 2>/dev/null || sleep 1
        head=$((head + 1))
        if [ "$head" -lt 16 ]; then
            printf '%s' "${UI_ESC}[5A"
        fi
    done
    trap - INT TERM
    printf '%s' "$UI_SHOW"
}

ui_banner() {
    ui_gap
    ui_logo_shine
    printf '  %s%sGCR Toolkit%s  %s%smake your shell more powerful%s\n' \
        "$UI_BOLD" "$UI_ACCENT" "$UI_RESET" "$UI_MUTED" "$UI_ITALIC" "$UI_RESET"
    ui_gap
}

# ------------------------------------------------------------------- input ---

# ui_ask <label> [default] -> UI_ANSWER
ui_ask() {
    printf '  %s%s%s %s%s%s' "$UI_ACCENT" "$UI_G_POINTER" "$UI_RESET" "$UI_BOLD" "$1" "$UI_RESET"
    if [ -n "${2:-}" ]; then
        printf ' %s(%s)%s' "$UI_MUTED" "$2" "$UI_RESET"
    fi
    printf ' %s›%s ' "$UI_ACCENT" "$UI_RESET"
    IFS= read -r UI_ANSWER
    if [ -z "$UI_ANSWER" ]; then
        UI_ANSWER="${2:-}"
    fi
}

# ui_confirm <question> [y|n], returns 0 for yes.
# In a terminal a single keypress answers: y, n, enter for the default, escape
# or q for no. The answer is echoed so the transcript reads back naturally.
# Without a terminal a whole line is read instead.
ui_confirm() {
    local default=${2:-y} answer=""
    printf '  %s?%s %s%s%s ' "$UI_WARN" "$UI_RESET" "$UI_BOLD" "$1" "$UI_RESET"
    if [ "$default" = y ]; then
        printf '%s[%s%sY%s%s/n]%s ' "$UI_MUTED" "$UI_RESET" "$UI_ACCENT$UI_BOLD" "$UI_RESET" "$UI_MUTED" "$UI_RESET"
    else
        printf '%s[y/%s%sN%s%s]%s ' "$UI_MUTED" "$UI_RESET" "$UI_ACCENT$UI_BOLD" "$UI_RESET" "$UI_MUTED" "$UI_RESET"
    fi

    if ui_interactive; then
        ui_keys_open
        while ui_read_key; do
            case "$UI_KEY" in
                y|Y) answer=y; break ;;
                n|N|q|Q|"$UI_ESC"|"$UI_INT") answer=n; break ;;
                ""|" "|"$UI_CR"|"$UI_LF") answer="$default"; break ;;
            esac
        done
        ui_keys_close
        if [ "$answer" = y ]; then
            printf '%syes%s\n' "$UI_ACCENT" "$UI_RESET"
        else
            printf '%sno%s\n' "$UI_MUTED" "$UI_RESET"
        fi
    else
        IFS= read -r answer
        if [ -z "$answer" ]; then
            answer="$default"
        fi
    fi
    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *) return 1 ;;
    esac
}

# ask_yes_no: compatibility alias for .ohmytool
ask_yes_no() {
    ui_confirm "$1" "${2:-y}"
}

# ui_keys_open / ui_keys_close
# While a menu or prompt reads single keys, Ctrl-C is delivered as a key
# instead of a signal, so cancelling never leaves a half drawn screen or a
# hidden cursor behind. zsh reads keys itself; bash reads raw bytes with dd,
# because its read builtin switches signals back on. The terminal settings
# are restored on close.
ui_keys_open() {
    UI_TTY_STATE=$(stty -g < /dev/tty 2>/dev/null || true)
    if [ -n "${ZSH_VERSION:-}" ]; then
        stty -isig < /dev/tty 2>/dev/null || true
    else
        stty -icanon -echo -isig min 1 time 0 < /dev/tty 2>/dev/null || true
    fi
}

ui_keys_close() {
    if [ -n "${UI_TTY_STATE:-}" ]; then
        stty "$UI_TTY_STATE" < /dev/tty 2>/dev/null || true
    fi
    UI_TTY_STATE=""
}

# ui_read_byte -> UI_BYTE, 1 when nothing arrived within the key wait.
ui_read_byte() {
    UI_BYTE=""
    if [ -n "${ZSH_VERSION:-}" ]; then
        read -s -k 1 -t "$UI_KEY_WAIT" UI_BYTE < /dev/tty 2>/dev/null
        return
    fi
    stty min 0 time "$UI_KEY_WAIT_DS" < /dev/tty 2>/dev/null || true
    UI_BYTE=$(dd bs=1 count=1 2>/dev/null < /dev/tty)
    stty min 1 time 0 < /dev/tty 2>/dev/null || true
    [ -n "$UI_BYTE" ]
}

# ui_read_key -> UI_KEY, one key from the terminal.
# An escape sequence is collected byte by byte up to its final letter, so an
# arrow key is handled at once and a bare escape only waits the key wait.
ui_read_key() {
    local key n=0 code more=0
    UI_KEY=""
    if [ -n "${ZSH_VERSION:-}" ]; then
        read -s -k 1 key < /dev/tty 2>/dev/null || return 1
    else
        key=$(dd bs=1 count=1 2>/dev/null < /dev/tty) || return 1
        # A multibyte character arrives one byte at a time; fetch the rest.
        if [ -n "$key" ]; then
            code=$(LC_ALL=C printf '%d' "'$key" 2>/dev/null)
            case "$code" in
                -*) code=$((code + 256)) ;;
            esac
            case "$code" in
                ''|*[!0-9]*) code=0 ;;
            esac
            if [ "$code" -ge 240 ]; then
                more=3
            elif [ "$code" -ge 224 ]; then
                more=2
            elif [ "$code" -ge 192 ]; then
                more=1
            fi
            if [ "$more" -gt 0 ]; then
                key="$key$(dd bs=1 count="$more" 2>/dev/null < /dev/tty)"
            fi
        fi
    fi
    if [ "$key" = "$UI_ESC" ]; then
        while [ "$n" -lt 8 ] && ui_read_byte; do
            key="$key$UI_BYTE"
            n=$((n + 1))
            case "$UI_BYTE" in
                [A-Za-z~]) break ;;
            esac
        done
    fi
    UI_KEY="$key"
}

# -------------------------------------------------------------------- menu ---
#
# ui_menu   <title> <subtitle> <name|description>...   pick one entry
# ui_choose <title> <subtitle> <name|description>...   pick any number
#
# Both draw a keyboard driven list: arrows or j/k move, digits jump, / filters
# by typing, enter confirms, q or escape cancels. ui_choose also toggles the
# entry under the cursor with space (tab while filtering) and every visible
# entry with a. Long lists scroll. Without a terminal the entries are numbered
# and read from a plain prompt instead.
#
# ui_menu sets UI_CHOICE to the 1 based index of the entry, 0 when cancelled,
# and UI_CHOICE_NAME to its name. ui_choose sets UI_PICKS to the chosen indices
# separated by spaces, UI_PICK_NAMES to their names and UI_PICK_COUNT;
# ui_picked <index> tells whether one entry was chosen. Both return 1 when
# cancelled.
#
# A cancelled menu erases itself completely. A confirmed one leaves its
# heading and a summary line behind, UI_MENU_FOOTPRINT lines in total, which
# ui_menu_erase removes when a caller steps back to an earlier menu.

ui_menu() {
    UI_MENU_MODE=single
    ui_menu_run "$@"
}

ui_choose() {
    UI_MENU_MODE=multi
    ui_menu_run "$@"
}

# ui_picked <index>: true when ui_choose picked that entry.
ui_picked() {
    case " $UI_PICKS " in
        *" $1 "*) return 0 ;;
    esac
    return 1
}

# ui_menu_erase <lines>
ui_menu_erase() {
    if [ "${1:-0}" -gt 0 ] && ui_interactive; then
        printf '\r%s' "${UI_ESC}[${1}A${UI_CLR_BELOW}"
    fi
}

ui_menu_run() {
    local title="$1" subtitle="$2" rows key
    shift 2
    UI_CHOICE=0
    UI_CHOICE_NAME=""
    UI_PICKS=""
    UI_PICK_NAMES=""
    UI_PICK_COUNT=0
    UI_MENU_FOOTPRINT=0

    ui_heading "$title" "$subtitle"
    if [ "$#" -eq 0 ]; then
        ui_note "nothing to choose from"
        ui_gap
        return 1
    fi

    if ! ui_interactive; then
        if [ "$UI_MENU_MODE" = multi ]; then
            ui_choose_plain "$@"
        else
            ui_menu_plain "$@"
        fi
        ui_menu_summary "$@"
        [ "$UI_CHOICE" -gt 0 ]
        return
    fi

    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions shwordsplit
    fi

    ui_menu_measure "$@"
    UI_COLS=$(ui_cols)
    rows=$(ui_rows)
    UI_MENU_HEIGHT=$((rows - 9))
    if [ "$UI_MENU_HEIGHT" -lt 3 ]; then
        UI_MENU_HEIGHT=3
    fi
    if [ "$UI_MENU_HEIGHT" -gt "$UI_MENU_COUNT" ]; then
        UI_MENU_HEIGHT=$UI_MENU_COUNT
    fi
    UI_MENU_QUERY=""
    UI_MENU_QUERY_LC=""
    UI_MENU_FILTERING=0
    UI_MENU_PICKED=" "
    UI_MENU_POS=1
    UI_MENU_TOP=1
    UI_MENU_FLASH=0
    UI_MENU_LINES=0
    UI_MENU_DONE=0
    ui_menu_filter

    ui_keys_open
    printf '%s' "$UI_HIDE"
    ui_menu_frame "$@"

    while [ "$UI_MENU_DONE" = 0 ]; do
        if ! ui_read_key || [ "$UI_KEY" = "$UI_INT" ]; then
            UI_MENU_DONE=2
            break
        fi
        key=$UI_KEY
        if [ "$UI_MENU_FILTERING" = 1 ]; then
            case "$key" in
                "$UI_ESC")
                    UI_MENU_QUERY=""
                    UI_MENU_QUERY_LC=""
                    UI_MENU_FILTERING=0
                    ui_menu_filter
                    UI_MENU_POS=1
                    ;;
                "$UI_DEL"|"$UI_BS")
                    if [ -z "$UI_MENU_QUERY" ]; then
                        UI_MENU_FILTERING=0
                    else
                        UI_MENU_QUERY=${UI_MENU_QUERY%?}
                        ui_menu_query_lc
                        ui_menu_filter
                        UI_MENU_POS=1
                    fi
                    ;;
                ""|"$UI_CR"|"$UI_LF") UI_MENU_DONE=1 ;;
                "$UI_TAB") ui_menu_toggle ;;
                "${UI_ESC}[A"|"${UI_ESC}OA") UI_MENU_POS=$((UI_MENU_POS - 1)) ;;
                "${UI_ESC}[B"|"${UI_ESC}OB") UI_MENU_POS=$((UI_MENU_POS + 1)) ;;
                "${UI_ESC}[H"|"${UI_ESC}[1~") UI_MENU_POS=1 ;;
                "${UI_ESC}[F"|"${UI_ESC}[4~") UI_MENU_POS=$UI_MENU_VCOUNT ;;
                "$UI_ESC"*|[[:cntrl:]]) ;;
                *)
                    UI_MENU_QUERY="${UI_MENU_QUERY}${key}"
                    ui_menu_query_lc
                    ui_menu_filter
                    UI_MENU_POS=1
                    ;;
            esac
        else
            case "$key" in
                "${UI_ESC}[A"|"${UI_ESC}OA"|k) UI_MENU_POS=$((UI_MENU_POS - 1)) ;;
                "${UI_ESC}[B"|"${UI_ESC}OB"|j) UI_MENU_POS=$((UI_MENU_POS + 1)) ;;
                "${UI_ESC}[H"|"${UI_ESC}[1~"|g) UI_MENU_POS=1 ;;
                "${UI_ESC}[F"|"${UI_ESC}[4~"|G) UI_MENU_POS=$UI_MENU_VCOUNT ;;
                /) UI_MENU_FILTERING=1 ;;
                " "|"$UI_TAB")
                    if [ "$UI_MENU_MODE" = multi ]; then
                        ui_menu_toggle
                    else
                        UI_MENU_DONE=1
                    fi
                    ;;
                a|A)
                    if [ "$UI_MENU_MODE" = multi ]; then
                        ui_menu_toggle_all
                    fi
                    ;;
                [1-9]) ui_menu_digit "$key" "$@" ;;
                ""|"$UI_CR"|"$UI_LF") UI_MENU_DONE=1 ;;
                q|Q|"$UI_ESC")
                    UI_MENU_DONE=2
                    break
                    ;;
            esac
        fi
        if [ "$UI_MENU_DONE" = 1 ] && [ "$UI_MENU_MODE" = single ] && [ "$UI_MENU_VCOUNT" -eq 0 ]; then
            UI_MENU_DONE=0
        fi
        ui_menu_clamp
        if [ "$UI_MENU_DONE" = 0 ]; then
            ui_menu_redraw "$@"
        fi
    done

    if [ "$UI_MENU_DONE" = 2 ]; then
        ui_menu_abort
        ui_keys_close
        return 1
    fi

    if [ "$UI_MENU_MODE" = multi ]; then
        ui_menu_collect
    else
        ui_menu_at "$UI_MENU_POS"
        UI_CHOICE=$UI_MENU_IDX
    fi
    if [ "${GCR_ANIM:-0}" = 1 ]; then
        UI_MENU_FLASH=1
        ui_menu_redraw "$@"
        sleep 0.08 2>/dev/null || true
    fi
    printf '\r%s' "${UI_ESC}[${UI_MENU_LINES}A${UI_CLR_BELOW}${UI_SHOW}"
    ui_keys_close
    ui_menu_summary "$@"
    UI_MENU_FOOTPRINT=5
    return 0
}

# Erase the frame and the heading, leaving the screen as it was before the menu.
ui_menu_abort() {
    printf '\r%s' "${UI_ESC}[${UI_MENU_LINES}A${UI_CLR_BELOW}${UI_ESC}[3A${UI_CLR_BELOW}${UI_SHOW}"
}

# Column width of the names and the lowercase haystack used by the filter.
ui_menu_measure() {
    local item name hay=""
    UI_MENU_COUNT=$#
    UI_MENU_NAMEW=10
    for item in "$@"; do
        name=${item%%|*}
        if [ "${#name}" -gt "$UI_MENU_NAMEW" ]; then
            UI_MENU_NAMEW=${#name}
        fi
        hay="${hay}${item}${UI_LF}"
    done
    if [ "$UI_MENU_NAMEW" -gt 28 ]; then
        UI_MENU_NAMEW=28
    fi
    UI_MENU_HAY=$(printf '%s' "$hay" | tr '[:upper:]|' '[:lower:] ')
}

ui_menu_query_lc() {
    UI_MENU_QUERY_LC=$(printf '%s' "$UI_MENU_QUERY" | tr '[:upper:]' '[:lower:]')
}

# Recompute the visible entries: every word of the query must appear in the
# entry, case insensitively.
ui_menu_filter() {
    local i=0 hay word ok globbing=1
    UI_MENU_VISIBLE=" "
    UI_MENU_VCOUNT=0
    if [ -z "$UI_MENU_QUERY_LC" ]; then
        while [ "$i" -lt "$UI_MENU_COUNT" ]; do
            i=$((i + 1))
            UI_MENU_VISIBLE="${UI_MENU_VISIBLE}${i} "
        done
        UI_MENU_VCOUNT=$UI_MENU_COUNT
        return 0
    fi
    case "$-" in
        *f*) globbing=0 ;;
    esac
    set -f
    while IFS= read -r hay; do
        i=$((i + 1))
        ok=1
        for word in $UI_MENU_QUERY_LC; do
            case "$hay" in
                *"$word"*) ;;
                *) ok=0; break ;;
            esac
        done
        if [ "$ok" = 1 ]; then
            UI_MENU_VISIBLE="${UI_MENU_VISIBLE}${i} "
            UI_MENU_VCOUNT=$((UI_MENU_VCOUNT + 1))
        fi
    done <<EOF
$UI_MENU_HAY
EOF
    if [ "$globbing" = 1 ]; then
        set +f
    fi
}

# ui_menu_at <position> -> UI_MENU_IDX, the entry index at a visible position.
ui_menu_at() {
    local pos=0 idx
    UI_MENU_IDX=0
    for idx in $UI_MENU_VISIBLE; do
        pos=$((pos + 1))
        if [ "$pos" -eq "$1" ]; then
            UI_MENU_IDX=$idx
            return 0
        fi
    done
    return 1
}

# Keep the cursor inside the list, wrapping at both ends, and scroll the
# window so the cursor stays in view.
ui_menu_clamp() {
    if [ "$UI_MENU_VCOUNT" -eq 0 ]; then
        UI_MENU_POS=1
        UI_MENU_TOP=1
        return 0
    fi
    if [ "$UI_MENU_POS" -lt 1 ]; then
        UI_MENU_POS=$UI_MENU_VCOUNT
    fi
    if [ "$UI_MENU_POS" -gt "$UI_MENU_VCOUNT" ]; then
        UI_MENU_POS=1
    fi
    if [ "$UI_MENU_POS" -lt "$UI_MENU_TOP" ]; then
        UI_MENU_TOP=$UI_MENU_POS
    fi
    if [ "$UI_MENU_POS" -gt $((UI_MENU_TOP + UI_MENU_HEIGHT - 1)) ]; then
        UI_MENU_TOP=$((UI_MENU_POS - UI_MENU_HEIGHT + 1))
    fi
    if [ "$UI_MENU_TOP" -gt $((UI_MENU_VCOUNT - UI_MENU_HEIGHT + 1)) ]; then
        UI_MENU_TOP=$((UI_MENU_VCOUNT - UI_MENU_HEIGHT + 1))
    fi
    if [ "$UI_MENU_TOP" -lt 1 ]; then
        UI_MENU_TOP=1
    fi
}

ui_menu_toggle() {
    ui_menu_at "$UI_MENU_POS" || return 0
    case "$UI_MENU_PICKED" in
        *" $UI_MENU_IDX "*) UI_MENU_PICKED=${UI_MENU_PICKED/ $UI_MENU_IDX / } ;;
        *) UI_MENU_PICKED="${UI_MENU_PICKED}${UI_MENU_IDX} " ;;
    esac
}

# Pick every visible entry, or clear them all when they are already picked.
ui_menu_toggle_all() {
    local idx all=1
    for idx in $UI_MENU_VISIBLE; do
        case "$UI_MENU_PICKED" in
            *" $idx "*) ;;
            *) all=0; break ;;
        esac
    done
    for idx in $UI_MENU_VISIBLE; do
        case "$UI_MENU_PICKED" in
            *" $idx "*)
                if [ "$all" = 1 ]; then
                    UI_MENU_PICKED=${UI_MENU_PICKED/ $idx / }
                fi
                ;;
            *)
                if [ "$all" = 0 ]; then
                    UI_MENU_PICKED="${UI_MENU_PICKED}${idx} "
                fi
                ;;
        esac
    done
}

# UI_PICKS in list order from the picked set. UI_CHOICE marks the confirmation.
ui_menu_collect() {
    local i=0
    UI_PICKS=""
    UI_PICK_COUNT=0
    UI_CHOICE=1
    while [ "$i" -lt "$UI_MENU_COUNT" ]; do
        i=$((i + 1))
        case "$UI_MENU_PICKED" in
            *" $i "*)
                UI_PICKS="${UI_PICKS:+$UI_PICKS }$i"
                UI_PICK_COUNT=$((UI_PICK_COUNT + 1))
                ;;
        esac
    done
}

# ui_menu_digit <digit> <items...>
# A digit jumps to that entry. With more than nine entries the first digit
# may be followed by a second one, or by enter to take it as it is. ui_menu
# confirms the entry, ui_choose only moves the cursor to it.
ui_menu_digit() {
    local key=$1 target=0
    shift
    if [ "$UI_MENU_COUNT" -le 9 ] || [ "$key" -gt $((UI_MENU_COUNT / 10)) ]; then
        target=$key
    else
        UI_MENU_POS=$key
        ui_menu_clamp
        ui_menu_redraw "$@"
        ui_read_key || return 0
        case "$UI_KEY" in
            "$UI_INT")
                UI_MENU_DONE=2
                return 0
                ;;
            [0-9])
                if [ "${key}${UI_KEY}" -le "$UI_MENU_COUNT" ]; then
                    target="${key}${UI_KEY}"
                else
                    return 0
                fi
                ;;
            ""|" "|"$UI_CR"|"$UI_LF") target=$key ;;
            *) return 0 ;;
        esac
    fi
    if [ "$target" -lt 1 ] || [ "$target" -gt "$UI_MENU_COUNT" ]; then
        return 0
    fi
    UI_MENU_POS=$target
    if [ "$UI_MENU_MODE" = single ]; then
        UI_MENU_DONE=1
    fi
}

# ui_hint <key|action>... -> UI_HINT, one muted line of key bindings.
ui_hint() {
    local pair sep=""
    UI_HINT="  "
    for pair in "$@"; do
        UI_HINT="${UI_HINT}${sep}${UI_MUTED}${UI_BOLD}${pair%%|*}${UI_RESET} ${UI_MUTED}${pair#*|}${UI_RESET}"
        sep=" ${UI_MUTED}${UI_G_DOT}${UI_RESET} "
    done
}

ui_menu_hint() {
    local move="${UI_G_UP}/${UI_G_DOWN}|move"
    if [ "$UI_MENU_FILTERING" = 1 ]; then
        if [ "$UI_MENU_MODE" = multi ]; then
            ui_hint "type|to filter" "$move" "tab|toggle" "enter|confirm" "esc|clear"
        else
            ui_hint "type|to filter" "$move" "enter|confirm" "esc|clear"
        fi
    elif [ "$UI_MENU_MODE" = multi ]; then
        ui_hint "$move" "space|toggle" "a|all" "/|filter" "enter|confirm" "q|quit"
    else
        ui_hint "$move" "1-${UI_MENU_COUNT}|pick" "/|filter" "enter|confirm" "q|quit"
    fi
}

# ui_menu_row <index> <position> <name> <description> -> UI_ROW
ui_menu_row() {
    local idx=$1 pos=$2 name=$3 desc=$4
    local pointer="  " on=0 cur=0 mark
    local c_pointer="" c_num="$UI_MUTED" c_mark="$UI_MUTED" c_name="" c_desc="$UI_MUTED"

    if [ "$pos" -eq "$UI_MENU_POS" ]; then
        cur=1
    fi
    if [ "$UI_MENU_MODE" = multi ]; then
        case "$UI_MENU_PICKED" in
            *" $idx "*) on=1 ;;
        esac
        if [ "$on" = 1 ]; then
            mark=$UI_G_CHECK_ON
        else
            mark=$UI_G_CHECK_OFF
        fi
    else
        on=$cur
        if [ "$on" = 1 ]; then
            mark=$UI_G_RADIO_ON
        else
            mark=$UI_G_RADIO_OFF
        fi
    fi

    if [ "$cur" = 1 ] && [ "$UI_MENU_FLASH" = 1 ]; then
        pointer="$UI_OK$UI_G_POINTER "
        c_num="$UI_BOLD$UI_OK"
        c_mark="$UI_BOLD$UI_OK"
        c_name="$UI_BOLD$UI_OK"
        c_desc="$UI_OK"
        mark=$UI_G_OK
    elif [ "$cur" = 1 ]; then
        pointer="$UI_ACCENT$UI_G_POINTER "
        c_num="$UI_BOLD$UI_ACCENT"
        c_mark="$UI_ACCENT"
        c_name="$UI_BOLD"
        c_desc=""
    elif [ "$on" = 1 ]; then
        c_mark="$UI_ACCENT"
    fi

    printf -v UI_ROW "  %s%s %s%2s%s %s%s%s %s%-${UI_MENU_NAMEW}s%s  %s%s%s" \
        "$pointer" "$UI_RESET" \
        "$c_num" "$idx" "$UI_RESET" \
        "$c_mark" "$mark" "$UI_RESET" \
        "$c_name" "$name" "$UI_RESET" \
        "$c_desc" "$desc" "$UI_RESET"
}

# ui_menu_frame <items...>: build the whole frame and write it in one go.
ui_menu_frame() {
    local buf="" lines=0 i=0 pos=0 last item name desc descw

    if [ "$UI_MENU_FILTERING" = 1 ]; then
        buf="${buf}  ${UI_ACCENT}/${UI_RESET} ${UI_BOLD}${UI_MENU_QUERY}${UI_RESET}${UI_REVERSE} ${UI_RESET}${UI_CLR}${UI_LF}"
        lines=$((lines + 1))
    fi
    if [ "$UI_MENU_TOP" -gt 1 ]; then
        buf="${buf}     ${UI_MUTED}${UI_G_UP} $((UI_MENU_TOP - 1)) more${UI_RESET}${UI_CLR}${UI_LF}"
        lines=$((lines + 1))
    fi

    last=$((UI_MENU_TOP + UI_MENU_HEIGHT - 1))
    descw=$((UI_COLS - UI_MENU_NAMEW - 13))
    for item in "$@"; do
        i=$((i + 1))
        case "$UI_MENU_VISIBLE" in
            *" $i "*) ;;
            *) continue ;;
        esac
        pos=$((pos + 1))
        if [ "$pos" -lt "$UI_MENU_TOP" ] || [ "$pos" -gt "$last" ]; then
            continue
        fi
        name=${item%%|*}
        desc=""
        case "$item" in
            *"|"*) desc=${item#*|} ;;
        esac
        ui_fit "$desc" "$descw"
        ui_menu_row "$i" "$pos" "$name" "$UI_FIT"
        buf="${buf}${UI_ROW}${UI_CLR}${UI_LF}"
        lines=$((lines + 1))
    done

    if [ "$UI_MENU_VCOUNT" -eq 0 ]; then
        buf="${buf}     ${UI_MUTED}no match${UI_RESET}${UI_CLR}${UI_LF}"
        lines=$((lines + 1))
    elif [ "$last" -lt "$UI_MENU_VCOUNT" ]; then
        buf="${buf}     ${UI_MUTED}${UI_G_DOWN} $((UI_MENU_VCOUNT - last)) more${UI_RESET}${UI_CLR}${UI_LF}"
        lines=$((lines + 1))
    fi

    ui_menu_hint
    buf="${buf}${UI_CLR}${UI_LF}${UI_HINT}${UI_CLR}${UI_LF}"
    lines=$((lines + 2))

    printf '%s%s' "$buf" "$UI_CLR_BELOW"
    UI_MENU_LINES=$lines
}

ui_menu_redraw() {
    printf '\r%s' "${UI_ESC}[${UI_MENU_LINES}A"
    ui_menu_frame "$@"
}

# The line a confirmed menu leaves behind.
ui_menu_summary() {
    local i=0 item names="" sep=""
    if [ "$UI_MENU_MODE" = multi ]; then
        if [ "$UI_CHOICE" -lt 1 ]; then
            ui_note "cancelled"
            ui_gap
            return 0
        fi
        UI_PICK_NAMES=""
        for item in "$@"; do
            i=$((i + 1))
            case " $UI_PICKS " in
                *" $i "*)
                    names="${names}${sep}${item%%|*}"
                    sep=", "
                    UI_PICK_NAMES="${UI_PICK_NAMES:+$UI_PICK_NAMES }${item%%|*}"
                    ;;
            esac
        done
        if [ "$UI_PICK_COUNT" -eq 0 ]; then
            printf '  %s%s%s %snothing selected%s\n\n' "$UI_MUTED" "$UI_G_DOT" "$UI_RESET" "$UI_MUTED" "$UI_RESET"
        else
            printf '  %s%s%s %s%s%s  %s%s selected%s\n\n' \
                "$UI_OK" "$UI_G_OK" "$UI_RESET" \
                "$UI_BOLD" "$names" "$UI_RESET" \
                "$UI_MUTED" "$UI_PICK_COUNT" "$UI_RESET"
        fi
        return 0
    fi

    if [ "$UI_CHOICE" -lt 1 ]; then
        ui_note "cancelled"
        ui_gap
        return 0
    fi
    for item in "$@"; do
        i=$((i + 1))
        if [ "$i" -eq "$UI_CHOICE" ]; then
            UI_CHOICE_NAME=${item%%|*}
            printf '  %s%s%s %s%s%s  %s%s%s %s%s%s\n\n' \
                "$UI_OK" "$UI_G_OK" "$UI_RESET" \
                "$UI_BOLD" "$UI_CHOICE_NAME" "$UI_RESET" \
                "$UI_MUTED" "$UI_G_ARROW" "$UI_RESET" \
                "$UI_MUTED" "${item#*|}" "$UI_RESET"
            return 0
        fi
    done
}

# Plain numbered fallbacks for shells without a terminal.
ui_menu_plain_list() {
    local i=0 item name desc
    ui_menu_measure "$@"
    for item in "$@"; do
        i=$((i + 1))
        name=${item%%|*}
        desc=""
        case "$item" in
            *"|"*) desc=${item#*|} ;;
        esac
        printf "  %s[%2s]%s %s%-${UI_MENU_NAMEW}s%s  %s%s%s\n" \
            "$UI_ACCENT" "$i" "$UI_RESET" \
            "$UI_BOLD" "$name" "$UI_RESET" \
            "$UI_MUTED" "$desc" "$UI_RESET"
    done
    printf '\n'
}

ui_menu_plain() {
    local answer
    ui_menu_plain_list "$@"
    printf '  %s%s%s Your choice (1-%s): ' "$UI_ACCENT" "$UI_G_POINTER" "$UI_RESET" "$#"
    IFS= read -r answer
    case "$answer" in
        ''|*[!0-9]*) UI_CHOICE=0 ;;
        *) UI_CHOICE="$answer" ;;
    esac
    if [ "$UI_CHOICE" -lt 1 ] || [ "$UI_CHOICE" -gt $# ]; then
        UI_CHOICE=0
    fi
}

ui_choose_plain() {
    local answer word i
    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions shwordsplit
    fi
    ui_menu_plain_list "$@"
    printf '  %s%s%s Your choice (numbers separated by spaces, a for all, empty to cancel): ' "$UI_ACCENT" "$UI_G_POINTER" "$UI_RESET"
    IFS= read -r answer
    UI_PICKS=""
    UI_PICK_COUNT=0
    UI_CHOICE=0
    if [ -z "$answer" ]; then
        return 0
    fi
    UI_CHOICE=1
    case "$answer" in
        a|A|all)
            i=0
            while [ "$i" -lt "$#" ]; do
                i=$((i + 1))
                UI_PICKS="${UI_PICKS:+$UI_PICKS }$i"
            done
            ;;
        *)
            for word in $(printf '%s' "$answer" | tr ',;' '  '); do
                case "$word" in
                    ''|*[!0-9]*) continue ;;
                esac
                if [ "$word" -ge 1 ] && [ "$word" -le "$#" ]; then
                    case " $UI_PICKS " in
                        *" $word "*) ;;
                        *) UI_PICKS="${UI_PICKS:+$UI_PICKS }$word" ;;
                    esac
                fi
            done
            ;;
    esac
    if [ -n "$UI_PICKS" ]; then
        UI_PICK_COUNT=$(printf '%s\n' "$UI_PICKS" | wc -w | tr -d ' ')
    fi
}

# ----------------------------------------------------- legacy print helpers ---
# Kept for .ohmytool. Signatures and line break behaviour are unchanged, only the
# palette follows the primitives above.

ui_legacy_color() {
    case "$1" in
        black)   UI_LEGACY_C="${UI_ESC}[30m" ;;
        red)     UI_LEGACY_C="$UI_ERR" ;;
        green)   UI_LEGACY_C="$UI_OK" ;;
        yellow)  UI_LEGACY_C="$UI_WARN" ;;
        blue)    UI_LEGACY_C="$UI_ACCENT" ;;
        magenta) UI_LEGACY_C="$UI_PURPLE" ;;
        cyan)    UI_LEGACY_C="$UI_CYAN" ;;
        white)   UI_LEGACY_C="${UI_ESC}[37m" ;;
        *)       UI_LEGACY_C="" ;;
    esac
    if [ "$UI_COLOR" = 0 ]; then
        UI_LEGACY_C=""
    fi
}

print_line() {
    ui_rule "${2:-$(ui_cols)}"
}

print_text() {
    local text_color="$1"
    local text="$2"
    local width="$4"
    local padding="" i=0

    ui_legacy_color "$text_color"

    if [ -n "$width" ] && [ "$width" -gt "${#text}" ]; then
        while [ "$i" -lt $(((width - ${#text}) / 2)) ]; do
            padding="$padding "
            i=$((i + 1))
        done
    fi

    printf '%s%s%s%s' "$UI_LEGACY_C" "$padding" "$text" "$UI_RESET"
}

print_table_text() {
    printf '\n  %s%s%s\n' "$UI_BOLD" "$1" "$UI_RESET"
}

print_error() {
    printf '\n'
    ui_err "$1"
}

print_warning() {
    printf '\n'
    ui_warn "$1"
}

print_success() {
    printf '\n'
    ui_ok "$1"
}

print_info() {
    printf '\n'
    ui_info "$1"
}

print_prompt() {
    printf '\n'
    printf '  %s%s%s %s' "$UI_ACCENT" "$UI_G_POINTER" "$UI_RESET" "$1"
    if [ -n "${2:-}" ]; then
        printf ' %s(default: %s)%s' "$UI_MUTED" "$2" "$UI_RESET"
    fi
    printf ': '
}

print_section() {
    ui_heading "$1"
}

print_menu_option() {
    printf '  %s[%s]%s %s%s%s' "$UI_ACCENT" "$1" "$UI_RESET" "$UI_BOLD" "$2" "$UI_RESET"
    if [ -n "${3:-}" ]; then
        printf '  %s%s%s' "$UI_MUTED" "$3" "$UI_RESET"
    fi
    printf '\n'
}

print_item() {
    printf '  %s[%2s]%s %s\n' "$UI_ACCENT" "$1" "$UI_RESET" "$2"
}

print_separator() {
    ui_rule "$(ui_cols)"
}

print_step() {
    case "${3:-pending}" in
        done)    printf '  %s%s%s ' "$UI_OK" "$UI_G_OK" "$UI_RESET" ;;
        running) printf '  %s%s%s ' "$UI_ACCENT" "$UI_G_ARROW" "$UI_RESET" ;;
        *)       printf '  %s%s%s ' "$UI_MUTED" "$UI_G_DOT" "$UI_RESET" ;;
    esac
    printf '%sStep %s%s %s%s%s\n' "$UI_MUTED" "$1" "$UI_RESET" "$UI_BOLD" "$2" "$UI_RESET"
}

print_confirm() {
    printf '\n'
    printf '  %s?%s %s ' "$UI_WARN" "$UI_RESET" "$1"
    if [ "${2:-y}" = y ]; then
        printf '%s[Y/n]%s ' "$UI_MUTED" "$UI_RESET"
    else
        printf '%s[y/N]%s ' "$UI_MUTED" "$UI_RESET"
    fi
}
