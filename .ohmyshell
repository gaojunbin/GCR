    alias l='joshuto'
fi
if [[ -f $HOME/.joshuto/target/release/joshuto ]]; then
    alias l='$HOME/.joshuto/target/release/joshuto'
fi

# clear terminal
alias cl='clear'
# view code with format
alias pcat='pygmentize -g'
# open tensorboard with tb
tb() {
  if [ -n "$TensorboardPort" ]; then
    tensorboard --logdir=./ --port="$TensorboardPort"
  else
    tensorboard --logdir=./
  fi
}
# download files or folder
download() {
    local entry items
    if [ $# -ge 1 ]; then
        tsz -r "$@"
        return
    fi
    items=()
    while IFS= read -r entry; do
        case "$entry" in
            '') continue ;;
            */) items+=("${entry%/}|folder") ;;
            *) items+=("${entry}|file") ;;
        esac
    done <<< "$(command ls -1p 2>/dev/null)"
    ui_menu "download" "send something from $(pwd)" "${items[@]}" || return 1
    tsz -r "$UI_CHOICE_NAME"
}

# upload folder
upload(){
    ui_menu "upload" "send files to this session" \
        "files|Upload one or more files" \
        "folders|Upload one or more folders"
    case "$UI_CHOICE" in
        1) trz ;;
        2) trz -r ;;
    esac
}
# open ssh with tssh --dragfile

alias tssh='tssh --dragfile'
alias tsshd='tssh --dragfile'

# VPN commands (only for Linux)
startvpn(){
    local all_port http_port https_port
    ui_heading "startvpn" "route this shell through a local proxy"
    ui_ask "Socks5 port" "7891"
    all_port=$UI_ANSWER
    ui_ask "HTTP port" "7890"
    http_port=$UI_ANSWER
    ui_ask "HTTPS port" "7890"
    https_port=$UI_ANSWER

    export ALL_PROXY=socks5://127.0.0.1:${all_port}
    export http_proxy=http://127.0.0.1:${http_port}
    export https_proxy=http://127.0.0.1:${https_port}

    ui_gap
    ui_ok "proxy enabled for this shell"
    ui_field "ALL_PROXY" "$ALL_PROXY"
    ui_field "http_proxy" "$http_proxy"
    ui_field "https_proxy" "$https_proxy"
    ui_note "check it with curl cip.cc, stop it with stopvpn"
    ui_gap
}
alias stopvpn='unset ALL_PROXY http_proxy https_proxy && ui_ok "proxy disabled for this shell"'

# a uniform function to view files with different formats
uview(){
    local filename=${1}
    if [ -z "$filename" ]; then
        ui_ask "File name"
        filename=$UI_ANSWER
    fi

    if [ ! -f "${filename}" ]; then
        ui_err "${filename} does not exist"
        return 1
    fi

    case "${filename}" in
        *.bam) samtools view ${filename} | less -S ;;
        *) ui_err "unsupported format, only .bam for now" ;;
    esac
}

# add to docker group
dockeradd(){
    local user
    ui_heading "dockeradd" "add a user to the docker group"
    ui_ask "User" "$(whoami)"
    user=$UI_ANSWER
    ui_command "sudo gpasswd -a ${user} docker"
    ui_gap
    sudo gpasswd -a $user docker
    newgrp docker
}

