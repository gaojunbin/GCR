# >>> mypermission >>>
# Function:
# 1. mychmod - modify directory permissions levels
# 2. mychown - modify directory owners
# 3. passwd - change passwards

# chmod
mychmod(){
    local dir mode
    ui_heading "mychmod" "change directory permissions"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "Permission, for example 755"
    mode=$UI_ANSWER
    if [ -z "$mode" ]; then
        ui_err "no permission given"
        return 1
    fi

    if ! ui_confirm "chmod -R ${mode} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chmod -R ${mode} ${dir}"
        sudo chmod -R ${mode} ${dir}
    else
        ui_command "chmod -R ${mode} ${dir}"
        chmod -R ${mode} ${dir}
    fi
    ui_gap
}

# chown 
mychown(){
    local dir owner
    ui_heading "mychown" "change directory owners"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "New owner, user or user:group"
    owner=$UI_ANSWER
    if [ -z "$owner" ]; then
        ui_err "no owner given"
        return 1
    fi

    if ! ui_confirm "chown -R ${owner} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chown -R ${owner} ${dir}"
        sudo chown -R ${owner} ${dir}
    else
        ui_command "chown -R ${owner} ${dir}"
        chown -R ${owner} ${dir}
    fi
    ui_gap
}

# Integrate all Permission commands
mypermission(){
    local footprint
    while :; do
        ui_menu "mypermission" "permission and password management" \
            "mychmod|Change directory permissions" \
            "mychown|Change directory owners" \
            "passwd|Change your password" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) mychmod ;;
            2) mychown ;;
            3) passwd ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
# <<< mypermission end <<<

# >>> mygit >>>
# some git config
alias gita='git add'
alias gitaa='git add .'
alias gitb='git branch'
gitc(){
    ui_ask "Commit message"
    if [ -z "$UI_ANSWER" ]; then
        ui_err "empty commit message"
        return 1
    fi
    git commit -m "$UI_ANSWER"
}
alias gitl='git log'
alias gitr='git reset'
alias gc='git clone'
gitch(){
    local line items
    if [ -n "${1:-}" ]; then
        git checkout "$1"
        return
    fi
    items=()
    while IFS= read -r line; do
        case "$line" in
            '* ('*|'') continue ;;
            '* '*) items+=("${line#\* }|current") ;;
            *) items+=("${line#  }|") ;;
        esac
    done <<< "$(git branch --no-color 2>/dev/null)"
    if [ "${#items[@]}" -eq 0 ]; then
        ui_err "no branches here"
        return 1
    fi
    ui_menu "gitch" "check out a branch" "${items[@]}" || return 1
    git checkout "$UI_CHOICE_NAME"
}
alias gitps='git push origin master'
alias gitpl='git pull'
alias gitst='git status'

# Integrate all Git commands
mygit(){
    local footprint
    while :; do
        ui_menu "mygit" "git workflow shortcuts" \
            "gita|git add" \
            "gitaa|git add ." \
            "gitc|git commit" \
            "gitl|git log" \
            "gitr|git reset" \
            "gc|git clone" \
            "gitch|git checkout" \
            "gitps|git push origin master" \
            "gitpl|git pull" \
            "gitst|git status" \
            "gitb|git branch" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) gita ;;
            2) gitaa ;;
            3) gitc ;;
            4) gitl ;;
            5) gitr ;;
            6) gc ;;
            7) gitch ;;
            8) gitps ;;
            9) gitpl ;;
            10) gitst ;;
            11) gitb ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
# <<< mygit end <<<

# >>> AI coding >>>
# Launchers for the agents that install_aicoding (.ohmytool) manages. When the
# tool is missing the launcher offers to install it, then starts it.
# All five shortcuts start their agent in its vendor-provided YOLO/bypass mode.
# 1. cc     - Claude Code without permission prompts
# 2. cx     - Codex without approvals and sandbox, cx_init writes its config
# 3. cursor - Cursor CLI agent in YOLO mode
# 4. google - Antigravity CLI without permission prompts
# 5. grok   - Grok Build in YOLO mode

# The vendor installers put their binaries here.
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *)
        if [ -d "$HOME/.local/bin" ]; then
            export PATH="$HOME/.local/bin:$PATH"
        fi
        ;;
esac

# aicoding_launch <tool> [args...]
aicoding_launch(){
    local tool=$1
    shift
    aicoding_info "$tool" || return 1
    if ! aicoding_bin "$tool"; then
        ui_gap
        ui_warn "${AICODING_NAME} is not installed"
        if ! ui_confirm "Install it now?"; then
            ui_note "install it later with install_aicoding"
            ui_gap
            return 1
        fi
        aicoding_install "$tool" || return 1
    fi
    "$AICODING_BIN" "$@"
}

cc(){ aicoding_launch claude --dangerously-skip-permissions "$@"; }
cx(){ aicoding_launch codex --dangerously-bypass-approvals-and-sandbox "$@"; }
cursor(){ aicoding_launch cursor --yolo "$@"; }
google(){ aicoding_launch antigravity --dangerously-skip-permissions "$@"; }
grok(){ aicoding_launch grok --yolo "$@"; }

# cx_init: write the Codex config for a custom OpenAI compatible endpoint. Only
# the endpoint and the API key are asked, the rest is fixed. Files go to
# ~/.codex (CODEX_HOME when set): config.toml and auth.json.
cx_init(){
    local dir=${CODEX_HOME:-$HOME/.codex} endpoint key
    ui_heading "cx_init" "Codex endpoint and API key"

    ui_ask "API endpoint" "https://ai.junbingao.com/v1"
    endpoint=$UI_ANSWER
    if [ -z "$endpoint" ]; then
        ui_err "no endpoint given"
        return 1
    fi

    printf '  %s%s%s %sAPI key%s %s(hidden)%s %s›%s ' "$UI_ACCENT" "$UI_G_POINTER" "$UI_RESET" "$UI_BOLD" "$UI_RESET" "$UI_MUTED" "$UI_RESET" "$UI_ACCENT" "$UI_RESET"
    IFS= read -rs key
    printf '\n'
    if [ -z "$key" ]; then
        ui_err "no API key given"
        return 1
    fi

    if [ -f "$dir/config.toml" ] || [ -f "$dir/auth.json" ]; then
        if ! ui_confirm "Overwrite config.toml and auth.json in ${dir}?" n; then
            ui_note "nothing changed"
            ui_gap
            return 0
        fi
    fi

    mkdir -p "$dir"
    endpoint=$(printf '%s' "$endpoint" | sed 's/[\\"]/\\&/g')
    key=$(printf '%s' "$key" | sed 's/[\\"]/\\&/g')
    cat > "$dir/config.toml" <<TOML
model = "gpt-5.6-sol"

model_provider = "JUNBINAI"
model_reasoning_effort = "ultra"
disable_response_storage = true
personality = "pragmatic"
preferred_auth_method = "apikey"
approvals_reviewer = "user"
approval_policy = "never"
sandbox_mode = "danger-full-access"

[model_providers.JUNBINAI]
name = "JUNBINAI"
base_url = "${endpoint}"
wire_api = "responses"
requires_openai_auth = true
TOML
    printf '{\n  "OPENAI_API_KEY": "%s"\n}\n' "$key" > "$dir/auth.json"
    chmod 600 "$dir/auth.json"

    ui_ok "wrote ${dir}/config.toml"
    ui_ok "wrote ${dir}/auth.json"
    ui_gap
}
# <<< AI coding end <<<

