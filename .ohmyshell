# =========How to use=============
# for bash
# >> echo 'source ~/.ohmyshell' >> ~/.bashrc
# for zsh
# >> echo 'source ~/.ohmyshell' >> ~/.zshrc
# =========Outline================
# --- myupdate - support update GCR Toolkit from GitHub Repo.
# |
# --- mytool - Some basic tools for common using.
# |
# --- mypip - pip tools.
# |
# --- myenv - Anaconda tools.
# |
# --- mygpu - useful functions for GPU and cuda.
# |
# --- mypermission - some functions for permission, passward, etc.
# |
# --- mygit - Git tools.
# |
# --- AI coding launchers - cc, cx, cx_init, cursor, google, grok.
# |
# --- Others
# ========Outline end============

# Never download a prompt dependency while starting a shell. This is also set
# before the instant prompt, whose cached preinit can run before Oh My Zsh.
GITSTATUS_AUTO_INSTALL=0
GCR_GITSTATUS_OFFLINE=1

# lazy load, zsh only: the prompt expansion below is a zsh feature
if [ -n "${ZSH_VERSION:-}" ] && [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source ~/.ohmyprint

# shell type [~/.bashrc or ~/.zshrc]
# support tabby shell working directory reporting
if [ -n "${ZSH_VERSION:-}" ];then
    declare -A manual_ohmyshell=(
        ["myupdate"]="support update GCR Toolkit from GitHub Repo."
        ["mytool"]="Some basic tools for common using."
        ["mypip"]="pip tools."
        ["myenv"]="Anaconda tools."
        ["mygpu"]="useful functions for GPU and cuda."
        ["mypermission"]="some functions for permission, passward, etc."
        ["mygit"]="Git tools"
    )
    shell_file=~/.zshrc
    precmd () { echo -n "\x1b]1337;CurrentDir=$(pwd)\x07"; }
elif [ -n "${BASH_VERSION:-}" ];then
    shell_file=~/.bashrc
    export PS1="$PS1\[\e]1337;CurrentDir="'$(pwd)\a\]'
else
    ui_err "unsupported shell: $SHELL"
fi

# Update checks never wait on the network during shell initialization.
GCR_CACHE_DIR=${GCR_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/gcr}
GCR_UPDATE_BASE_URL=${GCR_UPDATE_BASE_URL:-https://raw.githubusercontent.com/gaojunbin/GCR/master}
GCR_UPDATE_FILES=(
    .ohmyshell .ohmytool .ohmyzsh .p9k.zsh .vimrc .ohmyprint
    oh-my-zsh/custom/plugins/zsh-myincr/zsh-myincr.plugin.zsh
    oh-my-zsh/custom/themes/powerlevel10k/gitstatus/gitstatus.plugin.zsh
    oh-my-zsh/custom/themes/powerlevel10k/gitstatus/install
)

# Map the fixed list of repository paths to their installed paths.
gcr_installed_path() {
    case "$1" in
        oh-my-zsh/*) GCR_INSTALLED_PATH="$HOME/.${1}" ;;
        *) GCR_INSTALLED_PATH="$HOME/$1" ;;
    esac
}

gcr_now() {
    if [ -n "${ZSH_VERSION:-}" ]; then
        zmodload zsh/datetime
        GCR_NOW=$EPOCHSECONDS
    else
        GCR_NOW=$(date +%s)
    fi
}

gcr_fetch() {
    command curl -q -fsSL --connect-timeout 2 --max-time 10 --retry 0 "$1" -o "$2"
}

# Download once into a private directory; auto-update reuses these same files.
# No separate release manifest or publishing step is required.
gcr_fetch_release() {
    local directory=$1 file parent
    for file in "${GCR_UPDATE_FILES[@]}"; do
        parent=${file%/*}
        [ "$parent" != "$file" ] || parent=.
        command mkdir -p "$directory/$parent" || return 1
        gcr_fetch "$GCR_UPDATE_BASE_URL/$file" "$directory/$file" || return 1
        [ -s "$directory/$file" ] || return 1
        case "$file" in
            .vimrc) ;;
            *) command zsh -fn "$directory/$file" || return 1 ;;
        esac
        ui_step_ok "$file"
    done
}

# Called only after every download succeeded; a network error cannot look like
# a changed file. Comparison stays in the background, once per cache interval.
gcr_need_update() {
    local directory=$1 file
    for file in "${GCR_UPDATE_FILES[@]}"; do
        gcr_installed_path "$file"
        command cmp -s "$directory/$file" "$GCR_INSTALLED_PATH" || return 0
    done
    return 1
}

gcr_check_due() {
    local checked outcome extra interval=86400
    if { read -r checked outcome extra < "$GCR_CACHE_DIR/check"; } 2>/dev/null; then
        case "$checked" in ''|*[!0-9]*) return 0 ;; esac
        [ "${#checked}" -le 12 ] && [ -z "$extra" ] || return 0
        case "$outcome" in
            failed) interval=900 ;;
            current|available|updated) ;;
            *) return 0 ;;
        esac
        gcr_now
        [ "$checked" -le "$GCR_NOW" ] && [ $((GCR_NOW - checked)) -lt "$interval" ] && return 1
    fi
    return 0
}

# Called only in a worker subshell; the EXIT trap releases the directory lock.
# All network operations are bounded. An abandoned lock can be reclaimed after
# ten minutes (e.g. after SIGKILL or a reboot). A second mkdir elects one reaper.
gcr_acquire_update_lock() {
    local started stale
    command mkdir -p "$GCR_CACHE_DIR" || return 1
    if ! command mkdir "$GCR_CACHE_DIR/update.lock" 2>/dev/null; then
        { read -r started < "$GCR_CACHE_DIR/update.lock/started"; } 2>/dev/null || return 1
        case "$started" in ''|*[!0-9]*) return 1 ;; esac
        [ "${#started}" -le 12 ] || return 1
        gcr_now
        [ $((GCR_NOW - started)) -ge 600 ] || return 1
        command mkdir "$GCR_CACHE_DIR/update.lock/reap" 2>/dev/null || return 1
        stale=$(command mktemp -d "$GCR_CACHE_DIR/stale.XXXXXX") || return 1
        command mv "$GCR_CACHE_DIR/update.lock" "$stale/lock" || return 1
        command rm -rf "$stale"
        command mkdir "$GCR_CACHE_DIR/update.lock" 2>/dev/null || return 1
    fi
    gcr_now
    printf '%s\n' "$GCR_NOW" > "$GCR_CACHE_DIR/update.lock/started"
}

gcr_record_check() {
    gcr_now
    printf '%s %s\n' "$GCR_NOW" "$1" > "$GCR_CACHE_DIR/check.tmp" &&
        command mv -f "$GCR_CACHE_DIR/check.tmp" "$GCR_CACHE_DIR/check"
}

# Download and verify the complete release before replacing any installed file.
# Each replacement is atomic on the home filesystem; a failed replacement or
# INT/TERM rolls back all touched files. Keep backups if rollback itself fails.
gcr_install_release() (
    local downloaded=$1 stage file target parent committed=0 keep=0
    local touched=()
    stage=$(command mktemp -d "$HOME/.gcr-update.XXXXXX") || return 1
    gcr_release_cleanup() {
        local file target
        if [ "$committed" != 1 ]; then
            for file in "${touched[@]}"; do
                gcr_installed_path "$file"
                target=$GCR_INSTALLED_PATH
                if [ -e "$stage/old/$file" ] || [ -L "$stage/old/$file" ]; then
                    command mv -f "$stage/old/$file" "$target" || keep=1
                else
                    command rm -f "$target" || keep=1
                fi
            done
        fi
        if [ "$keep" = 1 ]; then
            printf 'GCR rollback incomplete; backups kept at %s\n' "$stage" >&2
        else
            command rm -rf "$stage"
        fi
    }
    trap gcr_release_cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    for file in "${GCR_UPDATE_FILES[@]}"; do
        parent=${file%/*}
        [ "$parent" != "$file" ] || parent=.
        command mkdir -p "$stage/new/$parent" "$stage/old/$parent" || return 1
        command cp "$downloaded/$file" "$stage/new/$file" || return 1
    done
    for file in "${GCR_UPDATE_FILES[@]}"; do
        gcr_installed_path "$file"
        target=$GCR_INSTALLED_PATH
        [ ! -d "$target" ] || return 1
        command mkdir -p "${target%/*}" || return 1
        if [ -e "$target" ] || [ -L "$target" ]; then
            command cp -Pp "$target" "$stage/old/$file" || return 1
        fi
    done
    for file in "${GCR_UPDATE_FILES[@]}"; do
        gcr_installed_path "$file"
        touched+=("$file")
        command mv -f "$stage/new/$file" "$GCR_INSTALLED_PATH" || return 1
    done
    committed=1
)

# Only cached release notes are printed; displaying a notice never uses network.
show_update_info() {
    local line seen=0
    [ -s "$GCR_CACHE_DIR/recent_updates" ] || return 0
    ui_heading "Latest update" "github.com/gaojunbin/GCR"
    while IFS= read -r line; do
        case "$line" in
            20[0-9][0-9]-*)
                [ "$seen" = 0 ] || break
                seen=1 ;;
        esac
        printf '    %s\n' "$line"
    done < "$GCR_CACHE_DIR/recent_updates"
    ui_gap
}

gcr_cache_release_notes() {
    if gcr_fetch "$GCR_UPDATE_BASE_URL/recent_updates" "$gcr_work/recent_updates"; then
        command mv -f "$gcr_work/recent_updates" "$GCR_CACHE_DIR/recent_updates"
    fi
    return 0
}

find_gcr_update() (
    local gcr_work result
    gcr_acquire_update_lock || return 0
    trap 'command rm -rf "$GCR_CACHE_DIR/update.lock"; [ -z "${gcr_work:-}" ] || command rm -rf "$gcr_work"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Another shell may have completed the check while this worker was starting.
    gcr_check_due || return 0
    gcr_work=$(command mktemp -d "$GCR_CACHE_DIR/check.XXXXXX") || return 1
    if ! gcr_fetch_release "$gcr_work/download"; then
        gcr_record_check failed
        return 1
    fi
    if gcr_need_update "$gcr_work/download"; then result=0; else result=$?; fi
    if [ "$result" = 1 ]; then
        command rm -f "$GCR_CACHE_DIR/available"
        gcr_record_check current
        return 0
    fi
    printf 'available\n' > "$GCR_CACHE_DIR/available" || return 1
    if [ "${AUTO_GCR_UPDATE:-false}" = true ]; then
        if ! gcr_install_release "$gcr_work/download"; then
            gcr_record_check failed
            return 1
        fi
        command rm -f "$GCR_CACHE_DIR/available"
        gcr_record_check updated
    else
        gcr_record_check available
    fi
    gcr_cache_release_notes
)

# Kept as an explicit entry point; no plugin installers run during startup.
myupdateplug() { :; }

myupdate() {
    ui_heading "Updating GCR" "github.com/gaojunbin/GCR"
    if ! (
        local gcr_work
        gcr_acquire_update_lock || { ui_note "another GCR update is running; try again later"; exit 1; }
        trap 'command rm -rf "$GCR_CACHE_DIR/update.lock"; [ -z "${gcr_work:-}" ] || command rm -rf "$gcr_work"' EXIT
        trap 'exit 130' INT
        trap 'exit 143' TERM
        gcr_work=$(command mktemp -d "$GCR_CACHE_DIR/check.XXXXXX") || exit 1
        if ! gcr_fetch_release "$gcr_work/download" ||
           ! gcr_install_release "$gcr_work/download"; then
            gcr_record_check failed
            exit 1
        fi
        command rm -f "$GCR_CACHE_DIR/available"
        gcr_record_check current
        gcr_cache_release_notes
    ); then
        ui_err "update failed; downloaded files were not applied, or replacements were rolled back"
        return 1
    fi
    ui_gap
    ui_ok "GCR is up to date"
    show_update_info
    if [ "${1:-}" = --no-restart ] || ! ui_interactive; then
        ui_note "restart your shell to load it"
        return 0
    fi
    if ui_confirm "Restart the shell now to load it?"; then
        if [ -n "${ZSH_VERSION:-}" ]; then exec zsh -l; else exec bash -l; fi
    else
        ui_note "it loads with your next shell"
    fi
}

gcr_startup_update() {
    case $- in *i*) ;; *) return 0 ;; esac
    [ "${CHECK_GCR_UPDATE:-true}" != false ] || return 0
    [ "${GCR_UPDATE_SCHEDULED:-0}" != 1 ] || return 0
    GCR_UPDATE_SCHEDULED=1
    if [ -s "$GCR_CACHE_DIR/available" ]; then
        printf '  GCR: a new version is available; run myupdate to upgrade.\n'
    fi
    gcr_check_due || return 0
    # Redirect every fd before launching: neither terminal output nor command
    # substitution pipes may be held open by a slow background request.
    if [ -n "${ZSH_VERSION:-}" ]; then
        setopt localoptions nomonitor nonotify
        eval 'find_gcr_update </dev/null >/dev/null 2>&1 &!'
    else
        find_gcr_update </dev/null >/dev/null 2>&1 &
        disown "$!" 2>/dev/null || true
    fi
}

# Explicit repair only. Normal startup never installs a prompt dependency.
gcr_repair_prompt() {
    local installer="$HOME/.oh-my-zsh/custom/themes/powerlevel10k/gitstatus/install"
    [ -f "$installer" ] || { ui_err "Powerlevel10k is not installed"; return 1; }
    if command sh "$installer"; then
        ui_ok "prompt dependency installed; restart your shell"
    else
        ui_err "could not install gitstatusd; retry gcr_repair_prompt when the network is available"
        return 1
    fi
}

show_GCR_info(){
    ui_banner
    ui_field "Author" "Junbin Gao" 10
    ui_field "GitHub" "github.com/gaojunbin/GCR" 10
    ui_field "Docs" "gcr.junbingao.com" 10

    if [ -z "${ZSH_VERSION:-}" ]; then
        ui_gap
        ui_note "the command manual needs zsh"
        return 0
    fi

    ui_heading "Core Commands" "run ohmyshell for interactive command hub"
    for k in "${(@ko)manual_ohmyshell}"; do
        ui_item "$k" "${manual_ohmyshell[$k]}" 16
    done

    ui_heading "AI Coding Launchers" "run any command to launch or install"
    ui_item "cc" "Claude Code without permission prompts" 16
    ui_item "cx" "Codex without approvals and sandbox" 16
    ui_item "cursor" "Cursor CLI agent in YOLO mode" 16
    ui_item "google" "Antigravity CLI in bypass mode" 16
    ui_item "grok" "Grok Build in YOLO mode" 16

    ui_gap
    ui_note "run ohmytool to install Docker, VPN, SpaceVim, AI agents and server tools"
    ui_gap
}
# 3.main content

export PATH=$HOME:$PATH

if [ -n "${ZSH_VERSION:-}" ]; then
    source ~/.ohmyzsh
    source ~/.p9k.zsh
fi
source ~/.ohmytool

# welcome message, after .ohmytool so its manual is known
if [ "${SHOW_GCR_INFO:-}" = "true" ]; then
    show_GCR_info
fi

# support server-administration
if [ -d ~/.server-administration ];then
    source ~/.server-administration/init.sh
fi

# support PBShelper
if [ -d ~/.PBShelper ];then
    source ~/.PBShelper/init.sh
fi

# support safe-rm
if [ -f ~/.safe-rm ];then

    trash_dir=${SAFE_RM_TRASH:="$HOME/.Trash"}
    alias rm='~/.safe-rm'
    alias del='~/.safe-rm -rf'
    alias delf='/bin/rm -rf'

    empty_trash() {
        ui_menu "empty_trash" "$trash_dir" \
            "everything|Remove all files in the trash" \
            "older than 30d|Remove files untouched for 30 days"
        case "$UI_CHOICE" in
            1)
                ui_step "clearing the trash"
                /bin/rm -rf "$trash_dir"/*
                ui_step_ok "trash cleared"
                ;;
            2)
                ui_step "clearing files older than 30 days"
                find "$trash_dir" -type f -mtime +30 -exec /bin/rm -f {} \;
                find "$trash_dir" -type d -empty -mtime +30 -exec rmdir {} \;
                ui_step_ok "files older than 30 days cleared"
                ;;
        esac
        ui_gap
    }
else
    printf '  %s%s%s rm is unprotected, run %sinstall_safe_rm%s and restart your shell\n\n' \
        "$UI_WARN" "$UI_G_WARN" "$UI_RESET" "$UI_BOLD" "$UI_RESET"
fi

# rewite vim and code
if [ -n "$SSH_CONNECTION" ]; then
    # remote server
    # support discard-vim
    if [ -f ~/.rmate ];then
        alias code='~/.rmate -p $RmatePort'
    fi
else
    # open with vs code (local)
    alias code='open -a "Visual Studio Code"'
fi

ohmyshell(){
    if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ] || ! ui_interactive; then
        ui_heading "GCR Command Reference" "run any entry to open its menu"
        ui_item "mytool" "Common tools for daily tasks" 16
        ui_item "mygit" "Git workflow shortcuts" 16
        ui_item "myenv" "Anaconda environment management" 16
        ui_item "mypip" "Python pip package management" 16
        ui_item "mygpu" "GPU and CUDA utilities" 16
        ui_item "mypermission" "Permission and password management" 16
        ui_item "myupdate" "Update GCR Toolkit from GitHub" 16
        ui_gap
        return 0
    fi

    # Cancelling a submenu comes back here: the hub erases its own trail and
    # draws itself again in place. Once a tool has run, the hub is done.
    local footprint
    while :; do
        ui_menu "ohmyshell" "GCR interactive command hub" \
            "mytool|Common tools for daily tasks" \
            "mygit|Git workflow shortcuts" \
            "myenv|Anaconda environment management" \
            "mypip|Python pip package management" \
            "mygpu|GPU and CUDA utilities" \
            "mypermission|Permission and password management" \
            "myupdate|Update GCR Toolkit from GitHub" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) mytool ;;
            2) mygit ;;
            3) myenv ;;
            4) mypip ;;
            5) mygpu ;;
            6) mypermission ;;
            7) myupdate ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}

# >>> mytool >>>
# Funtion:
# 1. jp - open jupyter lab
# 2. listen - ssh port forwarding
# 3. pathadd - add environment variable to PATH 
# 4. condainit - set conda initial and add startup shell to bashrc/zshrc
# 5. sz - view folder and file size
# 6. listen_vpn - listen remote server vpn (Only support Local)
# 7. download_googledrive - download file from google drive

# open jupyter notebook
jp(){
    local port
    ui_heading "jp" "start jupyter lab"
    if [ -z "$JupyterPort" ]; then
        ui_ask "Port" "8888"
        port=$UI_ANSWER
    else
        port=$JupyterPort
    fi
    ui_command "jupyter lab --port ${port} --no-browser"
    ui_gap
    jupyter lab --port ${port} --no-browser
}

# ssh -NL
listen(){
    local host rport lport
    ui_menu "listen" "ssh port forwarding" \
        "local -L|A local port listens to a remote port" \
        "remote -R|A remote port listens to a local port" \
        "dynamic -D|A socks5 proxy through the remote host"

    case "$UI_CHOICE" in
        1)
            ui_note "known hosts: $(awk '/^[[:space:]]*Host[[:space:]]/ { printf "%s ", $2 }' ~/.ssh/config 2>/dev/null)"
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Remote port"
            rport=$UI_ANSWER
            ui_ask "Local port" "$rport"
            lport=$UI_ANSWER
            ui_gap
            ui_command "ssh -L localhost:${lport}:localhost:${rport} ${host} -N"
            ui_note "running at http://localhost:${lport}"
            ui_gap
            ssh -L localhost:${lport}:localhost:${rport} ${host} -N
            ;;
        2)
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Local port"
            lport=$UI_ANSWER
            ui_ask "Remote port" "$lport"
            rport=$UI_ANSWER
            ui_gap
            ui_command "ssh -R localhost:${rport}:localhost:${lport} ${host} -N"
            ui_gap
            ssh -R localhost:${rport}:localhost:${lport} ${host} -N
            ;;
        3)
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Local port"
            lport=$UI_ANSWER
            ui_gap
            ui_command "ssh -D ${lport} ${host} -N"
            ui_gap
            ssh -D ${lport} ${host} -N
            ;;
    esac
}

# add environment variable to PATH
pathadd(){
    local pth
    ui_heading "pathadd" "add a directory to PATH"
    ui_ask "Directory"
    pth=$UI_ANSWER
    if [ -z "$pth" ]; then
        ui_err "no directory given"
        return 1
    fi

    if ui_confirm "Add it to ${shell_file} permanently?"; then
        echo '# >>> [Added by .ohmyshell] Add PATH to env >>>' >> ${shell_file}
        echo "export PATH=${pth}:"'$PATH' >> ${shell_file}
        echo '# <<< [Added by .ohmyshell] Add PATH to env end <<<' >> ${shell_file}
        ui_ok "added to ${shell_file}"
    else
        export PATH=${pth}:$PATH
        ui_ok "added to PATH for this session"
    fi
    ui_gap
}

# Set conda initial and add startup shell to bashrc/zshrc.
condainit(){
    local pth cpth
    ui_heading "condainit" "add the conda hook to your shell profile"
    ui_ask "Anaconda path" "/usr/local/anaconda3"
    pth=$UI_ANSWER
    cpth=${pth}/etc/profile.d/conda.sh

    if [ ! -f "$cpth" ]; then
        ui_warn "${cpth} does not exist"
    fi

    if ui_confirm "Add source ${cpth} to ${shell_file}?"; then
        echo '# >>> [Added by .ohmyshell] Conda initial >>>' >> ${shell_file}
        echo "source ${cpth}" >> ${shell_file}
        echo '# <<< [Added by .ohmyshell] Conda initial end <<<' >> ${shell_file}
        ui_ok "added to ${shell_file}"
    fi
    ui_gap
}

# view folder and file size
# TODO: add some param such like sz $1 $2
sz(){
    local target depth
    ui_menu "sz" "look at disk, folder and file usage" \
        "disks|Usage of every mounted disk" \
        "size|Size of a folder or file" \
        "count|Number of entries in a folder"

    case "$UI_CHOICE" in
        1)
            ui_command "df -h"
            ui_gap
            df -h
            ;;
        2)
            ui_ask "Folder or file" "*"
            target=$UI_ANSWER
            ui_ask "Max depth" "0"
            depth=$UI_ANSWER
            ui_gap
            if [ "$(uname -s)" = Darwin ]; then
                ui_command "du -h -d ${depth} ${target}"
                ui_gap
                du -h -d ${depth} ${target}
            else
                ui_command "du -h --max-depth=${depth} ${target}"
                ui_gap
                du -h --max-depth=${depth} ${target}
            fi
            ;;
        3)
            ui_ask "Folder" "."
            target=$UI_ANSWER
            ui_menu "count" "$target" \
                "all|Every entry" \
                "directories|Directories only" \
                "files|Regular files only" \
                "links|Symlinks only"
            case "$UI_CHOICE" in
                1) ui_command "ls -l ${target} | grep -c ^" ; ls -l ${target} | grep -c ^ ;;
                2) ui_command "ls -l ${target} | grep -c ^d" ; ls -l ${target} | grep -c ^d ;;
                3) ui_command "ls -l ${target} | grep -c ^-" ; ls -l ${target} | grep -c ^- ;;
                4) ui_command "ls -l ${target} | grep -c ^l" ; ls -l ${target} | grep -c ^l ;;
            esac
            ;;
    esac
    ui_gap
}

# listen remote server vpn (Only support Local)
listen_vpn(){
    local host lport
    ui_heading "listen_vpn" "forward a remote clash dashboard, local only"
    ui_ask "Host"
    host=$UI_ANSWER
    ui_ask "Local port" "9090"
    lport=$UI_ANSWER

    ui_gap
    ui_command "ssh -NL localhost:${lport}:localhost:9090 ${host}"
    ui_field "Dashboard" "http://clash.razord.top"
    ui_field "Host" "127.0.0.1"
    ui_field "Port" "$lport"
    ui_field "HTTP" "7890"
    ui_field "Socks5" "7891"
    ui_gap
    ssh -NL localhost:${lport}:localhost:9090 ${host}
}

# download file from google drive
download_googledrive(){
    local fileid
    ui_heading "download_gd" "download from google drive with gdown"
    ui_ask "File or folder id"
    fileid=$UI_ANSWER
    if [ -z "$fileid" ]; then
        ui_err "no id given"
        return 1
    fi

    ui_gap
    if ui_confirm "Is it a folder?" n; then
        ui_command "gdown --folder ${fileid}"
        gdown --folder ${fileid}
    else
        ui_command "gdown ${fileid}"
        gdown ${fileid}
    fi
}

# test vps
vpstest(){
    ui_heading "vpstest" "benchmark this machine with NodeBench"
