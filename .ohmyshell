# =========How to use=============
# for bash
# >> echo 'source ~/.ohmyshell' >> ~/.bashrc
# for zsh
# >> echo 'source ~/.ohmyshell' >> ~/.zshrc
# =========Outline================
# --- myupdate - support update GCR Toolkit from GitHub Repo.
# |
# --- mytool - Some basic tools for common using.
# |
# --- mypip - pip tools.
# |
# --- myenv - Anaconda tools.
# |
# --- mygpu - useful functions for GPU and cuda.
# |
# --- mypermission - some functions for permission, passward, etc.
# |
# --- mygit - Git tools.
# |
# --- Others
# ========Outline end============

# lazy load
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

source ~/.ohmyprint

# shell type [~/.bashrc or ~/.zshrc]
# support tabby shell working directory reporting
if [[ "$SHELL" == *"zsh" ]];then
    declare -A manual_ohmyshell=(
        ["myupdate"]="support update GCR Toolkit from GitHub Repo."
        ["mytool"]="Some basic tools for common using."
        ["mypip"]="pip tools."
        ["myenv"]="Anaconda tools."
        ["mygpu"]="useful functions for GPU and cuda."
        ["mypermission"]="some functions for permission, passward, etc."
        ["mygit"]="Git tools"
    )
    shell_file=~/.zshrc
    precmd () { echo -n "\x1b]1337;CurrentDir=$(pwd)\x07" }
elif [[ "$SHELL" == *"bash" ]];then
    shell_file=~/.bashrc
    export PS1="$PS1\[\e]1337;CurrentDir="'$(pwd)\a\]'
else
    ui_err "unsupported shell: $SHELL"
fi

# 1. check update
# GCR update time lock
GCR_update_file=$HOME/.gcr.update.lock
GCR_plugin_update_file=$HOME/.gcr.plugin.update.lock

show_update_info(){
    local updates=$(curl -fsSL https://raw.githubusercontent.com/gaojunbin/GCR/master/recent_updates 2>/dev/null)
    if [ -z "$updates" ]; then
        return 0
    fi

    ui_heading "Recent updates"
    echo "$updates" | while IFS= read -r line; do
        if [ -n "$line" ]; then
            ui_note "$line"
        else
            ui_gap
        fi
    done
    ui_gap
}

gcr_need_update(){
    if [ "$(uname -s)" = Darwin ];then
        remote_ohmyshell_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyshell | md5)
        remote_ohmytool_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmytool | md5)
        remote_ohmyzsh_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyzsh | md5)
        remote_p9k_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.p9k.zsh | md5)
        remote_vimrc_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.vimrc | md5)
        remote_ohmyprint_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyprint | md5)

        local_ohmyshell_MD5=$(md5 -q ~/.ohmyshell)
        local_ohmytool_MD5=$(md5 -q ~/.ohmytool)
        local_ohmyzsh_MD5=$(md5 -q ~/.ohmyzsh)
        local_p9k_MD5=$(md5 -q ~/.p9k.zsh)
        local_vimrc_MD5=$(md5 -q ~/.vimrc)
        local_ohmyprint_MD5=$(md5 -q ~/.ohmyprint)

    elif [ "$(uname -s)" = Linux ];then
        remote_ohmyshell_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyshell | md5sum | awk '{print $1}')
        remote_ohmytool_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmytool | md5sum | awk '{print $1}')
        remote_ohmyzsh_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyzsh | md5sum | awk '{print $1}')
        remote_p9k_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.p9k.zsh | md5sum | awk '{print $1}')
        remote_vimrc_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.vimrc | md5sum | awk '{print $1}')
        remote_ohmyprint_MD5=$(curl -sL https://raw.githubusercontent.com/gaojunbin/GCR/master/.ohmyprint | md5sum | awk '{print $1}')

        local_ohmyshell_MD5=$(md5sum ~/.ohmyshell | awk '{print $1}')
        local_ohmytool_MD5=$(md5sum ~/.ohmytool | awk '{print $1}')
        local_ohmyzsh_MD5=$(md5sum ~/.ohmyzsh | awk '{print $1}')
        local_p9k_MD5=$(md5sum ~/.p9k.zsh | awk '{print $1}')
        local_vimrc_MD5=$(md5sum ~/.vimrc | awk '{print $1}')
        local_ohmyprint_MD5=$(md5sum ~/.ohmyprint | awk '{print $1}')
    fi
        
    if [ "${remote_ohmyshell_MD5}" != "${local_ohmyshell_MD5}" ] || \
       [ "${remote_ohmytool_MD5}" != "${local_ohmytool_MD5}" ] || \
       [ "${remote_ohmyzsh_MD5}" != "${local_ohmyzsh_MD5}" ] || \
       [ "${remote_p9k_MD5}" != "${local_p9k_MD5}" ] || \
       [ "${remote_vimrc_MD5}" != "${local_vimrc_MD5}" ] || \
       [ "${remote_ohmyprint_MD5}" != "${local_ohmyprint_MD5}" ]; then
        
        return 0
    else
        return 1
    fi
}

# support update GCR Toolkit from GitHub Repo
myupdate(){
    local base=https://raw.githubusercontent.com/gaojunbin/GCR/master
    local tmp=${TMPDIR:-/tmp}/gcr-update.$$
    local failed=0 file

    ui_heading "Updating GCR" "github.com/gaojunbin/GCR"
    for file in .ohmyshell .ohmytool .ohmyzsh .p9k.zsh .vimrc .ohmyprint; do
        ui_step "$file"
        if curl -fsSL "$base/$file" -o "$tmp"; then
            mv "$tmp" "$HOME/$file"
            ui_step_ok "$file"
        else
            ui_step_err "$file"
            failed=1
        fi
    done
    rm -f "$tmp"

    if [ "$failed" = 1 ]; then
        ui_gap
        ui_err "some files could not be downloaded, GCR was left as it was"
        ui_gap
        return 1
    fi

    date +%s > $GCR_update_file
    show_update_info
    ui_note "reloading ${shell_file}"
    ui_gap
    source ${shell_file}
}

myupdateplug(){
    # update_joshuto
    # update_PBShelper
    # update_tssh
    # update_safe_rm
    # date +%s > $GCR_plugin_update_file
    # source ${shell_file}
}

find_gcr_update(){
    if gcr_need_update; then
        # only auto update when AUTO_GCR_UPDATE is explicitly set to true
        if [ "${AUTO_GCR_UPDATE}" = "true" ]; then
            myupdate
        else
            show_update_info
            printf '  %s%s%s A new version is available, run %smyupdate%s to upgrade\n\n' \
                "$UI_ACCENT" "$UI_G_UP" "$UI_RESET" "$UI_BOLD" "$UI_RESET"
            date +%s > $GCR_update_file
        fi
    fi
}

# if CHECK_GCR_UPDATE is not false, check update every login
if [ "${CHECK_GCR_UPDATE:-}" != "false" ]; then
    find_gcr_update
fi

# ==================Auto Check Update per day (GCR & GCR plugin)==================
if [ -f "$GCR_update_file" ]; then
    last_timestamp=$(cat $GCR_update_file)
    current_timestamp=$(date +%s)

    if [[ "$last_timestamp" =~ ^[0-9]+$ ]]; then
        diff=$((current_timestamp - last_timestamp))
        # 1 days (86400s)
        if [ $diff -ge 86400 ]; then
            find_gcr_update
        fi
    else
        find_gcr_update
    fi
else
    find_gcr_update
fi

if [ -f "$GCR_plugin_update_file" ]; then
    last_timestamp=$(cat $GCR_plugin_update_file)
    current_timestamp=$(date +%s)

    if [[ "$last_timestamp" =~ ^[0-9]+$ ]]; then
        diff=$((current_timestamp - last_timestamp))
        # 1 days (86400s)
        if [ $diff -ge 86400 ]; then
            myupdateplug
        fi
    else
        myupdateplug
    fi
else
    myupdateplug
fi

show_GCR_info(){
    ui_gap
    ui_logo
    ui_heading "GCR Toolkit" "make your shell more powerful"
    ui_field "Author" "Junbin Gao"
    ui_field "GitHub" "github.com/gaojunbin/GCR"
    ui_field "Docs" "gcr.junbingao.com"

    if [ -z "${ZSH_VERSION:-}" ]; then
        ui_gap
        ui_note "the command manual needs zsh"
        return 0
    fi

    ui_heading "ohmyshell" "shell commands, run ohmyshell for the full list"
    for k in "${(@ko)manual_ohmyshell}"; do
        ui_item "$k" "${manual_ohmyshell[$k]}"
    done

    ui_heading "ohmytool" "installers and setup, run ohmytool for the full list"
    for k in "${(@ko)manual_ohmytool}"; do
        ui_item "$k" "${manual_ohmytool[$k]}" 30
    done
    ui_gap
}
# 3.main content

export PATH=$HOME:$PATH

source ~/.ohmyzsh
source ~/.p9k.zsh
source ~/.ohmytool

# welcome message, after .ohmytool so its manual is known
if [ "${SHOW_GCR_INFO:-}" = "true" ]; then
    show_GCR_info
fi

# support server-administration
if [ -d ~/.server-administration ];then
    source ~/.server-administration/init.sh
fi

# support PBShelper
if [ -d ~/.PBShelper ];then
    source ~/.PBShelper/init.sh
fi

# support safe-rm
if [ -f ~/.safe-rm ];then

    trash_dir=${SAFE_RM_TRASH:="$HOME/.Trash"}
    alias rm='~/.safe-rm'
    alias del='~/.safe-rm -rf'
    alias delf='/bin/rm -rf'

    empty_trash() {
        ui_menu "empty_trash" "$trash_dir" \
            "everything|Remove all files in the trash" \
            "older than 30d|Remove files untouched for 30 days"
        case "$UI_CHOICE" in
            1)
                ui_step "clearing the trash"
                /bin/rm -rf "$trash_dir"/*
                ui_step_ok "trash cleared"
                ;;
            2)
                ui_step "clearing files older than 30 days"
                find "$trash_dir" -type f -mtime +30 -exec /bin/rm -f {} \;
                find "$trash_dir" -type d -empty -mtime +30 -exec rmdir {} \;
                ui_step_ok "files older than 30 days cleared"
                ;;
        esac
        ui_gap
    }
else
    printf '  %s%s%s rm is unprotected, run %sinstall_safe_rm%s and restart your shell\n\n' \
        "$UI_WARN" "$UI_G_WARN" "$UI_RESET" "$UI_BOLD" "$UI_RESET"
fi

# rewite vim and code
if [ -n "$SSH_CONNECTION" ]; then
    # remote server
    # support discard-vim
    if [ -f ~/.rmate ];then
        alias code='~/.rmate -p $RmatePort'
    fi
else
    # open with vs code (local)
    alias code='open -a "Visual Studio Code"'
fi

ohmyshell(){
    ui_heading "GCR Command Reference" "run any entry to open its menu"
    ui_item "myupdate" "Update GCR Toolkit from GitHub"
    ui_item "mytool" "Common tools for daily tasks"
    ui_item "mypip" "Python pip management tools"
    ui_item "myenv" "Anaconda environment management"
    ui_item "mygpu" "GPU and CUDA utilities"
    ui_item "mypermission" "Permission and password management"
    ui_item "mygit" "Git workflow shortcuts"
    ui_gap
}

# >>> mytool >>>
# Funtion:
# 1. jp - open jupyter lab
# 2. listen - ssh port forwarding
# 3. pathadd - add environment variable to PATH 
# 4. condainit - set conda initial and add startup shell to bashrc/zshrc
# 5. sz - view folder and file size
# 6. listen_vpn - listen remote server vpn (Only support Local)
# 7. download_googledrive - download file from google drive

# open jupyter notebook
jp(){
    local port
    ui_heading "jp" "start jupyter lab"
    if [ -z "$JupyterPort" ]; then
        ui_ask "Port" "8888"
        port=$UI_ANSWER
    else
        port=$JupyterPort
    fi
    ui_command "jupyter lab --port ${port} --no-browser"
    ui_gap
    jupyter lab --port ${port} --no-browser
}

# ssh -NL
listen(){
    local host rport lport
    ui_menu "listen" "ssh port forwarding" \
        "local -L|A local port listens to a remote port" \
        "remote -R|A remote port listens to a local port" \
        "dynamic -D|A socks5 proxy through the remote host"

    case "$UI_CHOICE" in
        1)
            ui_note "known hosts: $(awk '/^[[:space:]]*Host[[:space:]]/ { printf "%s ", $2 }' ~/.ssh/config 2>/dev/null)"
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Remote port"
            rport=$UI_ANSWER
            ui_ask "Local port" "$rport"
            lport=$UI_ANSWER
            ui_gap
            ui_command "ssh -L localhost:${lport}:localhost:${rport} ${host} -N"
            ui_note "running at http://localhost:${lport}"
            ui_gap
            ssh -L localhost:${lport}:localhost:${rport} ${host} -N
            ;;
        2)
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Local port"
            lport=$UI_ANSWER
            ui_ask "Remote port" "$lport"
            rport=$UI_ANSWER
            ui_gap
            ui_command "ssh -R localhost:${rport}:localhost:${lport} ${host} -N"
            ui_gap
            ssh -R localhost:${rport}:localhost:${lport} ${host} -N
            ;;
        3)
            ui_ask "Host"
            host=$UI_ANSWER
            ui_ask "Local port"
            lport=$UI_ANSWER
            ui_gap
            ui_command "ssh -D ${lport} ${host} -N"
            ui_gap
            ssh -D ${lport} ${host} -N
            ;;
    esac
}

# add environment variable to PATH
pathadd(){
    local pth
    ui_heading "pathadd" "add a directory to PATH"
    ui_ask "Directory"
    pth=$UI_ANSWER
    if [ -z "$pth" ]; then
        ui_err "no directory given"
        return 1
    fi

    if ui_confirm "Add it to ${shell_file} permanently?"; then
        echo '# >>> [Added by .ohmyshell] Add PATH to env >>>' >> ${shell_file}
        echo "export PATH=${pth}:"'$PATH' >> ${shell_file}
        echo '# <<< [Added by .ohmyshell] Add PATH to env end <<<' >> ${shell_file}
        ui_ok "added to ${shell_file}"
    else
        export PATH=${pth}:$PATH
        ui_ok "added to PATH for this session"
    fi
    ui_gap
}

# Set conda initial and add startup shell to bashrc/zshrc.
condainit(){
    local pth cpth
    ui_heading "condainit" "add the conda hook to your shell profile"
    ui_ask "Anaconda path" "/usr/local/anaconda3"
    pth=$UI_ANSWER
    cpth=${pth}/etc/profile.d/conda.sh

    if [ ! -f "$cpth" ]; then
        ui_warn "${cpth} does not exist"
    fi

    if ui_confirm "Add source ${cpth} to ${shell_file}?"; then
        echo '# >>> [Added by .ohmyshell] Conda initial >>>' >> ${shell_file}
        echo "source ${cpth}" >> ${shell_file}
        echo '# <<< [Added by .ohmyshell] Conda initial end <<<' >> ${shell_file}
        ui_ok "added to ${shell_file}"
    fi
    ui_gap
}

# view folder and file size
# TODO: add some param such like sz $1 $2
sz(){
    local target depth
    ui_menu "sz" "look at disk, folder and file usage" \
        "disks|Usage of every mounted disk" \
        "size|Size of a folder or file" \
        "count|Number of entries in a folder"

    case "$UI_CHOICE" in
        1)
            ui_command "df -h"
            ui_gap
            df -h
            ;;
        2)
            ui_ask "Folder or file" "*"
            target=$UI_ANSWER
            ui_ask "Max depth" "0"
            depth=$UI_ANSWER
            ui_gap
            if [ "$(uname -s)" = Darwin ]; then
                ui_command "du -h -d ${depth} ${target}"
                ui_gap
                du -h -d ${depth} ${target}
            else
                ui_command "du -h --max-depth=${depth} ${target}"
                ui_gap
                du -h --max-depth=${depth} ${target}
            fi
            ;;
        3)
            ui_ask "Folder" "."
            target=$UI_ANSWER
            ui_menu "count" "$target" \
                "all|Every entry" \
                "directories|Directories only" \
                "files|Regular files only" \
                "links|Symlinks only"
            case "$UI_CHOICE" in
                1) ui_command "ls -l ${target} | grep -c ^" ; ls -l ${target} | grep -c ^ ;;
                2) ui_command "ls -l ${target} | grep -c ^d" ; ls -l ${target} | grep -c ^d ;;
                3) ui_command "ls -l ${target} | grep -c ^-" ; ls -l ${target} | grep -c ^- ;;
                4) ui_command "ls -l ${target} | grep -c ^l" ; ls -l ${target} | grep -c ^l ;;
            esac
            ;;
    esac
    ui_gap
}

# listen remote server vpn (Only support Local)
listen_vpn(){
    local host lport
    ui_heading "listen_vpn" "forward a remote clash dashboard, local only"
    ui_ask "Host"
    host=$UI_ANSWER
    ui_ask "Local port" "9090"
    lport=$UI_ANSWER

    ui_gap
    ui_command "ssh -NL localhost:${lport}:localhost:9090 ${host}"
    ui_field "Dashboard" "http://clash.razord.top"
    ui_field "Host" "127.0.0.1"
    ui_field "Port" "$lport"
    ui_field "HTTP" "7890"
    ui_field "Socks5" "7891"
    ui_gap
    ssh -NL localhost:${lport}:localhost:9090 ${host}
}

# download file from google drive
download_googledrive(){
    local fileid
    ui_heading "download_gd" "download from google drive with gdown"
    ui_ask "File or folder id"
    fileid=$UI_ANSWER
    if [ -z "$fileid" ]; then
        ui_err "no id given"
        return 1
    fi

    ui_gap
    if ui_confirm "Is it a folder?" n; then
        ui_command "gdown --folder ${fileid}"
        gdown --folder ${fileid}
    else
        ui_command "gdown ${fileid}"
        gdown ${fileid}
    fi
}

# test vps
vpstest(){
    ui_heading "vpstest" "benchmark this machine with NodeBench"
    bash <(curl -sL https://raw.githubusercontent.com/LloydAsp/NodeBench/main/NodeBench.sh)
}

# Integrate all tool commands
mytool(){
    ui_menu "mytool" "common tools for daily tasks" \
        "jp|Open Jupyter Lab" \
        "listen|SSH port forwarding" \
        "pathadd|Add a directory to PATH" \
        "condainit|Initialise conda" \
        "sz|View disk usage" \
        "listen_vpn|Listen to a remote VPN, local only" \
        "download_gd|Download from Google Drive" \
        "vpstest|Test VPS performance"
    case "$UI_CHOICE" in
        1) jp ;;
        2) listen ;;
        3) pathadd ;;
        4) condainit ;;
        5) sz ;;
        6) listen_vpn ;;
        7) download_googledrive ;;
        8) vpstest ;;
    esac
}
