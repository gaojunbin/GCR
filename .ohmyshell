# >>> mypip >>>
# Function:
# 1. pipset - modify pip source
# 2. pipbase - pip install some base module
# 3. pipl - pip list and pip show
# 4. pipi - pip install
# 5. pipu - pip uninstall

# modify pip source
pipset(){
    local index
    ui_menu "pipset" "choose a pip index" \
        "tsinghua|pypi.tuna.tsinghua.edu.cn" \
        "aliyun|mirrors.aliyun.com" \
        "tencent|mirrors.cloud.tencent.com"

    case "$UI_CHOICE" in
        1) index=https://pypi.tuna.tsinghua.edu.cn/simple ;;
        2) index=https://mirrors.aliyun.com/pypi/simple/ ;;
        3) index=http://mirrors.cloud.tencent.com/pypi/simple ;;
        *) return 0 ;;
    esac

    ui_command "pip config set global.index-url ${index}"
    pip config set global.index-url ${index}
    ui_gap
}

# pip install some base module
pipbase(){
    local pkg
    ui_heading "pipbase" "install the packages GCR leans on"
    for pkg in pygments gpustat jupyterlab tensorboard woaigpu gdown shell-gpt; do
        if ui_confirm "pip install ${pkg}?" n; then
            pip install ${pkg}
        fi
    done
    ui_gap
}

# pip list and pip show
pipl(){
    if [ "${1}" = "" ]; then
        ui_command "pip list"
        ui_gap
        pip list
    else
        ui_command "pip show ${1}"
        ui_gap
        pip show ${1}
    fi
}

# pip install
pipi(){
    if [ "${1}" = "" ]; then
        if ui_confirm "pip install -r req*.txt?"; then
            pip install -r req*.txt
        fi
    else
        ui_command "pip install $@"
        ui_gap
        pip install "$@"
    fi
}

# pip uninstall
pipu(){
    if [ "${1}" = "" ]; then
        pipl
        ui_ask "Package to uninstall"
        if [ -n "$UI_ANSWER" ]; then
            pip uninstall ${UI_ANSWER}
        fi
    else
       pip uninstall "$@"
    fi
}

# Integrate all tool commands
mypip(){
    ui_menu "mypip" "python package management" \
        "pipset|Configure the pip source" \
        "pipbase|Install the base packages" \
        "pipl|List or show packages" \
        "pipi|Install packages" \
        "pipu|Uninstall packages"
    case "$UI_CHOICE" in
        1) pipset ;;
        2) pipbase ;;
        3) pipl ;;
        4) pipi ;;
        5) pipu ;;
    esac
}
# <<< mypip end <<<

# >>> myenv >>>
# Funtion:
# 1. env - Activate an environment
# 2. lenv - List installed environments
# 3. cenv - Create new environments
# 4. denv - Delete an installed environment

# conda activate
env() {
    local conda_env_list line name location items count

    if [ -n "$1" ]; then
        conda activate "$1"
        return
    fi

    conda_env_list=$(conda env list 2>/dev/null | tail -n +3)
    if [ -z "$conda_env_list" ]; then
        ui_warn "no conda environments found"
        return 1
    fi

    items=()
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        name=$(echo "$line" | awk '{print $1}')
        if [ -z "$name" ]; then
            continue
        fi
        if [[ "$line" == *"*"* ]]; then
            location=$(echo "$line" | awk '{for(i=3;i<=NF;i++) printf "%s ", $i}')
            items+=("$name|active   ${location}")
        else
            location=$(echo "$line" | awk '{for(i=2;i<=NF;i++) printf "%s ", $i}')
            items+=("$name|${location}")
        fi
    done <<< "$conda_env_list"
    items+=("deactivate|Leave the current environment")
    count=${#items[@]}

    ui_menu "env" "conda environments" "${items[@]}"
    if [ "$UI_CHOICE" -lt 1 ]; then
        return 0
    fi

    if [ "$UI_CHOICE" = "$count" ]; then
        conda deactivate
        ui_ok "environment deactivated"
    else
        conda activate "$UI_CHOICE_NAME"
        ui_ok "activated ${UI_CHOICE_NAME}"
    fi
    ui_gap
}

# list conda envs
alias lenv='conda info -e'

# create conda env
cenv(){
    local name from py
    ui_heading "cenv" "create a conda environment"
    ui_ask "Name"
    name=$UI_ANSWER
    if [ -z "$name" ]; then
        ui_err "no name given"
        return 1
    fi

    conda env list
    ui_ask "Clone from an existing environment"
    from=$UI_ANSWER
    ui_gap

    if [ -n "$from" ]; then
        ui_command "conda create --name ${name} --clone ${from}"
        ui_gap
        conda create --name ${name} --clone ${from}
        return
    fi

    ui_ask "Python version" "3.7"
    py=$UI_ANSWER
    ui_gap
    ui_command "conda create --name ${name} python=${py} ipykernel -y"
    ui_gap
    conda create --name ${name} python=${py} ipykernel -y
    ui_command "python -m ipykernel install --user --name ${name}"
    python -m ipykernel install --user --name ${name}
}

# delete conda env
denv(){
    local name
    ui_heading "denv" "delete a conda environment"
    conda env list
    ui_ask "Name"
    name=$UI_ANSWER
    if [ -z "$name" ]; then
        ui_err "no name given"
        return 1
    fi

    if ui_confirm "Delete ${name} and everything in it?" n; then
        ui_command "conda remove -n ${name} --all"
        ui_gap
        conda remove -n ${name} --all
    else
        ui_note "${name} was left alone"
        ui_gap
    fi
}

# Integrate all conda commands
myenv(){
    ui_menu "myenv" "conda environment management" \
        "env|Activate an environment" \
        "lenv|List environments" \
        "cenv|Create an environment" \
        "denv|Delete an environment"
    case "$UI_CHOICE" in
        1) env ;;
        2) lenv ;;
        3) cenv ;;
        4) denv ;;
    esac
}
# <<< myenv end <<<

# >>> mygpu >>>
# Function:
# 1. gpu - gpustat realtime
# 2. nvidia - nvidia-smi realtime
# 3. pid - view pids for all gpus
# 4. gpus - CUDA_VISIBLE_DEVICES

# gpu listen
alias gpu='gpustat -i 0.2 -p'
alias nvidia='watch -n 0.2 nvidia-smi'
alias gpus='echo "CUDA_VISIBLE_DEVICES"'

# View pids for all gpus 
pid(){
    if ui_confirm "Use sudo?" n; then
        ui_command "sudo fuser -v /dev/nvidia*"
        ui_gap
        sudo fuser -v /dev/nvidia*
    else
        ui_command "fuser -v /dev/nvidia*"
        ui_gap
        fuser -v /dev/nvidia*
    fi
}

# Integrate all GPU commands
mygpu(){
    ui_menu "mygpu" "gpu and cuda utilities" \
        "gpu|GPU status through gpustat" \
        "nvidia|GPU status through nvidia-smi" \
        "pid|View the processes holding a GPU" \
        "gpus|Show CUDA_VISIBLE_DEVICES"
    case "$UI_CHOICE" in
        1) gpu ;;
        2) nvidia ;;
        3) pid ;;
        4) gpus ;;
    esac
}
# <<< GPU end <<<

# >>> mypermission >>>
# Function:
# 1. mychmod - modify directory permissions levels
# 2. mychown - modify directory owners
# 3. passwd - change passwards

# chmod
mychmod(){
    local dir mode
    ui_heading "mychmod" "change directory permissions"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "Permission, for example 755"
    mode=$UI_ANSWER
    if [ -z "$mode" ]; then
        ui_err "no permission given"
        return 1
    fi

    if ! ui_confirm "chmod -R ${mode} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chmod -R ${mode} ${dir}"
        sudo chmod -R ${mode} ${dir}
    else
        ui_command "chmod -R ${mode} ${dir}"
        chmod -R ${mode} ${dir}
    fi
    ui_gap
}

# chown 
mychown(){
    local dir owner
    ui_heading "mychown" "change directory owners"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "New owner, user or user:group"
    owner=$UI_ANSWER
    if [ -z "$owner" ]; then
        ui_err "no owner given"
        return 1
    fi

    if ! ui_confirm "chown -R ${owner} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chown -R ${owner} ${dir}"
        sudo chown -R ${owner} ${dir}
    else
        ui_command "chown -R ${owner} ${dir}"
        chown -R ${owner} ${dir}
    fi
    ui_gap
}

# Integrate all Permission commands
mypermission(){
    ui_menu "mypermission" "permission and password management" \
        "mychmod|Change directory permissions" \
        "mychown|Change directory owners" \
        "passwd|Change your password"
    case "$UI_CHOICE" in
        1) mychmod ;;
        2) mychown ;;
        3) passwd ;;
    esac
}
# <<< mypermission end <<<

# >>> mygit >>>
# some git config
alias gita='git add'
alias gitaa='git add .'
alias gitb='git branch'
gitc(){
    ui_ask "Commit message"
    if [ -z "$UI_ANSWER" ]; then
        ui_err "empty commit message"
        return 1
    fi
    git commit -m "$UI_ANSWER"
}
alias gitl='git log'
alias gitr='git reset'
alias gc='git clone'
gitch(){
    if [ "${1}" = "" ]; then
        gitb
        ui_ask "Branch to check out"
        if [ -n "$UI_ANSWER" ]; then
            git checkout "$UI_ANSWER"
        fi
    else
        git checkout "${1}"
    fi
}
alias gitps='git push origin master'
alias gitpl='git pull'
alias gitst='git status'

# Integrate all Git commands
mygit(){
    ui_menu "mygit" "git workflow shortcuts" \
        "gita|git add" \
        "gitaa|git add ." \
        "gitc|git commit" \
        "gitl|git log" \
        "gitr|git reset" \
        "gc|git clone" \
        "gitch|git checkout" \
        "gitps|git push origin master" \
        "gitpl|git pull" \
        "gitst|git status" \
        "gitb|git branch"
    case "$UI_CHOICE" in
        1) gita ;;
        2) gitaa ;;
        3) gitc ;;
        4) gitl ;;
        5) gitr ;;
        6) gc ;;
        7) gitch ;;
        8) gitps ;;
        9) gitpl ;;
        10) gitst ;;
        11) gitb ;;
    esac
}
# <<< mygit end <<<

# >>> Others >>>
# update bash/zsh profile
alias sc="source ${shell_file}"
# list directory
if [[ -f ~/.ruby/bin/colorls ]] || [[ -f /usr/local/bin/colorls ]];then
    if [[ -f ~/.ruby/bin/colorls ]];then
        export PATH=~/.ruby/bin:$PATH
    fi
    alias ls='colorls --sd'
    alias la='colorls --sd --all'
    alias ll='colorls --sd --all -l'
    alias tree='colorls --tree'
else
    alias ll='ls -alF'
    alias la='ls -A'
    alias l='ls -CF'
fi

# support joshuto
if command -v joshuto >/dev/null 2>&1; then
    alias l='joshuto'
fi
if [[ -f $HOME/.joshuto/target/release/joshuto ]]; then
    alias l='$HOME/.joshuto/target/release/joshuto'
fi

# clear terminal
alias cl='clear'
# view code with format
alias pcat='pygmentize -g'
# open tensorboard with tb
tb() {
  if [ -n "$TensorboardPort" ]; then
    tensorboard --logdir=./ --port="$TensorboardPort"
  else
    tensorboard --logdir=./
  fi
}
# download files or folder
download() {
  if [ $# -ge 1 ]; then
    tsz -r "$@"
  else
    PS3="$(printf '  %s%s%s select a file or folder: ' "$UI_ACCENT" "$UI_G_POINT" "$UI_RESET")"
    select file in *; do
      if [ -n "$file" ]; then
        tsz -r "$file"
        break
      else
        echo "Invalid selection, please make a new selection."
      fi
    done
    unset PS3
  fi
}

# upload folder
upload(){
    ui_menu "upload" "send files to this session" \
        "files|Upload one or more files" \
        "folders|Upload one or more folders"
    case "$UI_CHOICE" in
        1) trz ;;
        2) trz -r ;;
    esac
}
# open ssh with tssh --dragfile

alias tssh='tssh --dragfile'
alias tsshd='tssh --dragfile'

# VPN commands (only for Linux)
startvpn(){
    local all_port http_port https_port
    ui_heading "startvpn" "route this shell through a local proxy"
    ui_ask "Socks5 port" "7891"
    all_port=$UI_ANSWER
    ui_ask "HTTP port" "7890"
    http_port=$UI_ANSWER
    ui_ask "HTTPS port" "7890"
    https_port=$UI_ANSWER

    export ALL_PROXY=socks5://127.0.0.1:${all_port}
    export http_proxy=http://127.0.0.1:${http_port}
    export https_proxy=http://127.0.0.1:${https_port}

    ui_gap
    ui_ok "proxy enabled for this shell"
    ui_field "ALL_PROXY" "$ALL_PROXY"
    ui_field "http_proxy" "$http_proxy"
    ui_field "https_proxy" "$https_proxy"
    ui_note "check it with curl cip.cc, stop it with stopvpn"
    ui_gap
}
alias stopvpn='unset ALL_PROXY http_proxy https_proxy && ui_ok "proxy disabled for this shell"'

# a uniform function to view files with different formats
uview(){
    local filename=${1}
    if [ -z "$filename" ]; then
        ui_ask "File name"
        filename=$UI_ANSWER
    fi

    if [ ! -f "${filename}" ]; then
        ui_err "${filename} does not exist"
        return 1
    fi

    case "${filename}" in
        *.bam) samtools view ${filename} | less -S ;;
        *) ui_err "unsupported format, only .bam for now" ;;
    esac
}

# add to docker group
dockeradd(){
    local user
    ui_heading "dockeradd" "add a user to the docker group"
    ui_ask "User" "$(whoami)"
    user=$UI_ANSWER
    ui_command "sudo gpasswd -a ${user} docker"
    ui_gap
    sudo gpasswd -a $user docker
    newgrp docker
}

# <<< Others end <<<
