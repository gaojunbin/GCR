# >>> mypermission >>>
# Function:
# 1. mychmod - modify directory permissions levels
# 2. mychown - modify directory owners
# 3. passwd - change passwards

# chmod
mychmod(){
    local dir mode
    ui_heading "mychmod" "change directory permissions"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "Permission, for example 755"
    mode=$UI_ANSWER
    if [ -z "$mode" ]; then
        ui_err "no permission given"
        return 1
    fi

    if ! ui_confirm "chmod -R ${mode} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chmod -R ${mode} ${dir}"
        sudo chmod -R ${mode} ${dir}
    else
        ui_command "chmod -R ${mode} ${dir}"
        chmod -R ${mode} ${dir}
    fi
    ui_gap
}

# chown 
mychown(){
    local dir owner
    ui_heading "mychown" "change directory owners"
    ui_ask "Directory"
    dir=$UI_ANSWER
    if [ ! -d "$dir" ]; then
        ui_err "${dir} is not a directory"
        return 1
    fi

    ui_ask "New owner, user or user:group"
    owner=$UI_ANSWER
    if [ -z "$owner" ]; then
        ui_err "no owner given"
        return 1
    fi

    if ! ui_confirm "chown -R ${owner} ${dir}?"; then
        ui_note "nothing changed"
        ui_gap
        return 0
    fi

    if ui_confirm "Use sudo?" n; then
        ui_command "sudo chown -R ${owner} ${dir}"
        sudo chown -R ${owner} ${dir}
    else
        ui_command "chown -R ${owner} ${dir}"
        chown -R ${owner} ${dir}
    fi
    ui_gap
}

# Integrate all Permission commands
mypermission(){
    local footprint
    while :; do
        ui_menu "mypermission" "permission and password management" \
            "mychmod|Change directory permissions" \
            "mychown|Change directory owners" \
            "passwd|Change your password" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) mychmod ;;
            2) mychown ;;
            3) passwd ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
# <<< mypermission end <<<

# >>> mygit >>>
# some git config
alias gita='git add'
alias gitaa='git add .'
alias gitb='git branch'
gitc(){
    ui_ask "Commit message"
    if [ -z "$UI_ANSWER" ]; then
        ui_err "empty commit message"
        return 1
    fi
    git commit -m "$UI_ANSWER"
}
alias gitl='git log'
alias gitr='git reset'
alias gc='git clone'
gitch(){
    local line items
    if [ -n "${1:-}" ]; then
        git checkout "$1"
        return
    fi
    items=()
    while IFS= read -r line; do
        case "$line" in
            '* ('*|'') continue ;;
            '* '*) items+=("${line#\* }|current") ;;
            *) items+=("${line#  }|") ;;
        esac
    done <<< "$(git branch --no-color 2>/dev/null)"
    if [ "${#items[@]}" -eq 0 ]; then
        ui_err "no branches here"
        return 1
    fi
    ui_menu "gitch" "check out a branch" "${items[@]}" || return 1
    git checkout "$UI_CHOICE_NAME"
}
alias gitps='git push origin master'
alias gitpl='git pull'
alias gitst='git status'

# Integrate all Git commands
mygit(){
    local footprint
    while :; do
        ui_menu "mygit" "git workflow shortcuts" \
            "gita|git add" \
            "gitaa|git add ." \
            "gitc|git commit" \
            "gitl|git log" \
            "gitr|git reset" \
            "gc|git clone" \
            "gitch|git checkout" \
            "gitps|git push origin master" \
            "gitpl|git pull" \
            "gitst|git status" \
            "gitb|git branch" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) gita ;;
            2) gitaa ;;
            3) gitc ;;
            4) gitl ;;
            5) gitr ;;
            6) gc ;;
            7) gitch ;;
            8) gitps ;;
            9) gitpl ;;
            10) gitst ;;
            11) gitb ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
