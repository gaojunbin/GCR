# >>> mypip >>>
# Function:
# 1. pipset - modify pip source
# 2. pipbase - pip install some base module
# 3. pipl - pip list and pip show
# 4. pipi - pip install
# 5. pipu - pip uninstall

# modify pip source
pipset(){
    local index
    ui_menu "pipset" "choose a pip index" \
        "tsinghua|pypi.tuna.tsinghua.edu.cn" \
        "aliyun|mirrors.aliyun.com" \
        "tencent|mirrors.cloud.tencent.com"

    case "$UI_CHOICE" in
        1) index=https://pypi.tuna.tsinghua.edu.cn/simple ;;
        2) index=https://mirrors.aliyun.com/pypi/simple/ ;;
        3) index=http://mirrors.cloud.tencent.com/pypi/simple ;;
        *) return 0 ;;
    esac

    ui_command "pip config set global.index-url ${index}"
    pip config set global.index-url ${index}
    ui_gap
}

# pip install some base module
pipbase(){
    local pkg i=0
    ui_choose "pipbase" "install the packages GCR leans on" \
        "pygments|Syntax highlighting, used by pcat" \
        "gpustat|GPU status, used by gpu" \
        "jupyterlab|Jupyter Lab, used by jp" \
        "tensorboard|TensorBoard, used by tb" \
        "woaigpu|GPU watcher" \
        "gdown|Google Drive downloads, used by download_gd" \
        "shell-gpt|ChatGPT in the terminal" || return 1
    for pkg in pygments gpustat jupyterlab tensorboard woaigpu gdown shell-gpt; do
        i=$((i + 1))
        ui_picked "$i" || continue
        ui_command "pip install ${pkg}"
        pip install "${pkg}"
        ui_gap
    done
}

# pip list and pip show
pipl(){
    if [ "${1}" = "" ]; then
        ui_command "pip list"
        ui_gap
        pip list
    else
        ui_command "pip show ${1}"
        ui_gap
        pip show ${1}
    fi
}

# pip install
pipi(){
    if [ "${1}" = "" ]; then
        if ui_confirm "pip install -r req*.txt?"; then
            pip install -r req*.txt
        fi
    else
        ui_command "pip install $@"
        ui_gap
        pip install "$@"
    fi
}

# pip uninstall
pipu(){
    if [ "${1}" = "" ]; then
        pipl
        ui_ask "Package to uninstall"
        if [ -n "$UI_ANSWER" ]; then
            pip uninstall ${UI_ANSWER}
        fi
    else
       pip uninstall "$@"
    fi
}

# Integrate all tool commands
mypip(){
    local footprint
    while :; do
        ui_menu "mypip" "python package management" \
            "pipset|Configure the pip source" \
            "pipbase|Install the base packages" \
            "pipl|List or show packages" \
            "pipi|Install packages" \
            "pipu|Uninstall packages" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) pipset ;;
            2) pipbase ;;
            3) pipl ;;
            4) pipi ;;
            5) pipu ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
# <<< mypip end <<<

# >>> myenv >>>
# Funtion:
# 1. env - Activate an environment
# 2. lenv - List installed environments
# 3. cenv - Create new environments
# 4. denv - Delete an installed environment

# conda_envs -> CONDA_ENVS, one name|location entry per environment, the
# active one marked. Returns 1 when conda has nothing to list.
conda_envs() {
    local line name location
    CONDA_ENVS=()
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        name=$(printf '%s\n' "$line" | awk '{print $1}')
        if [ -z "$name" ]; then
            continue
        fi
        if [[ "$line" == *"*"* ]]; then
            location=$(printf '%s\n' "$line" | awk '{for(i=3;i<=NF;i++) printf "%s ", $i}')
            CONDA_ENVS+=("$name|active   ${location}")
        else
            location=$(printf '%s\n' "$line" | awk '{for(i=2;i<=NF;i++) printf "%s ", $i}')
            CONDA_ENVS+=("$name|${location}")
        fi
    done <<< "$(conda env list 2>/dev/null | tail -n +3)"
    if [ "${#CONDA_ENVS[@]}" -eq 0 ]; then
        ui_warn "no conda environments found"
        return 1
    fi
}

# conda activate
env() {
    local count
    if [ -n "$1" ]; then
        conda activate "$1"
        return
    fi
    conda_envs || return 1
    count=$((${#CONDA_ENVS[@]} + 1))

    ui_menu "env" "conda environments" "${CONDA_ENVS[@]}" \
        "deactivate|Leave the current environment" || return 1

    if [ "$UI_CHOICE" = "$count" ]; then
        conda deactivate
        ui_ok "environment deactivated"
    else
        conda activate "$UI_CHOICE_NAME"
        ui_ok "activated ${UI_CHOICE_NAME}"
    fi
    ui_gap
}

# list conda envs
alias lenv='conda info -e'

# create conda env
cenv(){
    local name from py
    ui_heading "cenv" "create a conda environment"
    ui_ask "Name"
    name=$UI_ANSWER
    if [ -z "$name" ]; then
        ui_err "no name given"
        return 1
    fi

    from=""
    if conda_envs; then
        ui_menu "cenv" "start from" \
            "fresh|A new environment with its own python" \
            "${CONDA_ENVS[@]}" || return 1
        if [ "$UI_CHOICE" -gt 1 ]; then
            from=$UI_CHOICE_NAME
        fi
    fi

    if [ -n "$from" ]; then
        ui_command "conda create --name ${name} --clone ${from}"
        ui_gap
        conda create --name ${name} --clone ${from}
        return
    fi

    ui_ask "Python version" "3.7"
    py=$UI_ANSWER
    ui_gap
    ui_command "conda create --name ${name} python=${py} ipykernel -y"
    ui_gap
    conda create --name ${name} python=${py} ipykernel -y
    ui_command "python -m ipykernel install --user --name ${name}"
    python -m ipykernel install --user --name ${name}
}

# delete conda env
denv(){
    local name
    conda_envs || return 1
    ui_menu "denv" "delete a conda environment" "${CONDA_ENVS[@]}" || return 1
    name=$UI_CHOICE_NAME

    if ui_confirm "Delete ${name} and everything in it?" n; then
        ui_command "conda remove -n ${name} --all"
        ui_gap
        conda remove -n ${name} --all
    else
        ui_note "${name} was left alone"
        ui_gap
    fi
}

# Integrate all conda commands
myenv(){
    local footprint
    while :; do
        ui_menu "myenv" "conda environment management" \
            "env|Activate an environment" \
            "lenv|List environments" \
            "cenv|Create an environment" \
            "denv|Delete an environment" || return 1
        footprint=$UI_MENU_FOOTPRINT
        case "$UI_CHOICE" in
            1) env ;;
            2) lenv ;;
            3) cenv ;;
            4) denv ;;
        esac
        if [ "$UI_CHOICE" -gt 0 ]; then
            return 0
        fi
        ui_menu_erase "$footprint"
    done
}
# <<< myenv end <<<

