# Tool functions are loaded on demand by .ohmyshell.
if [ "${GCR_RUNTIME_LOADED:-0}" != 1 ]; then
    if [ -n "${ZSH_VERSION:-}" ]; then
        eval 'GCR_SOURCE_FILE=${(%):-%x}'
    else
        GCR_SOURCE_FILE=${BASH_SOURCE[0]}
    fi
    : "${GCR_INSTALL_ROOT:=$(cd "$(dirname "$GCR_SOURCE_FILE")" && pwd)}"
    if [ -f "$GCR_INSTALL_ROOT/lib/core.sh" ]; then
        . "$GCR_INSTALL_ROOT/lib/core.sh"
    elif [ -f "$GCR_INSTALL_ROOT/.gcr/lib/core.sh" ]; then
        . "$GCR_INSTALL_ROOT/.gcr/lib/core.sh"
    else
        printf '%s\n' 'GCR runtime modules are missing; rerun the GCR installer.' >&2
        return 1
    fi
    gcr_init || return
    . "$GCR_INSTALL_ROOT/.ohmyprint" || return
    . "$GCR_LIB_DIR/catalog.sh" || return
fi
. "$GCR_LIB_DIR/install.sh" || return
. "$GCR_LIB_DIR/aicoding.sh" || return
for gcr_module in cli editors network services; do
    . "$GCR_LIB_DIR/installers/$gcr_module.sh" || return
done
unset gcr_module
GCR_TOOLS_LOADED=1

_ohmytool_collect() {
    local cat line name seen=" "
    OHMYTOOL_ITEMS=()
    if [ "$1" = all ]; then
        while IFS= read -r cat; do
            cat=${cat%%|*}
            while IFS= read -r line; do
                name=${line%%|*}
                case "$seen" in
                    *" $name "*) continue ;;
                esac
                seen="${seen}${name} "
                OHMYTOOL_ITEMS+=("$line")
            done <<< "$(_ohmytool_items "$cat")"
        done <<< "$(_ohmytool_categories)"
        return 0
    fi
    while IFS= read -r line; do
        if [ -n "$line" ]; then
            OHMYTOOL_ITEMS+=("$line")
        fi
    done <<< "$(_ohmytool_items "$1")"
}

_ohmytool_list(){
    local cat item
    ui_heading "ohmytool" "server management & toolkits catalog"

    ui_note "One-click installation and environment setup. Run any command directly or run ohmytool for the interactive menu."
    ui_gap

    while IFS= read -r cat; do
        cat=${cat%%|*}
        printf '  %s%s%s\n' "$UI_BOLD$UI_ACCENT" "$(_ohmytool_title "$cat")" "$UI_RESET"
        _ohmytool_collect "$cat"
        for item in "${OHMYTOOL_ITEMS[@]}"; do
            ui_item "${item%%|*}" "${item#*|}" 28
        done
        ui_gap
    done <<< "$(_ohmytool_categories)"

    ui_note "Tip: Run 'ohmytool' for interactive menu, or type any function name above directly."
    ui_gap
}

_ohmytool_pick() {
    local title subtitle item
    _ohmytool_collect "$1"
    if [ "${#OHMYTOOL_ITEMS[@]}" -eq 1 ]; then
        for item in "${OHMYTOOL_ITEMS[@]}"; do
            gcr_install "${item%%|*}"
            return $?
        done
    fi
    if [ "$1" = all ]; then
        title="ohmytool ${UI_G_POINT} all tools"
        subtitle="type / to search"
    else
        title="ohmytool ${UI_G_POINT} $(_ohmytool_title "$1")"
        subtitle=""
    fi
    ui_menu "$title" "$subtitle" "${OHMYTOOL_ITEMS[@]}" || return 1
    gcr_install "$UI_CHOICE_NAME"
}

ohmytool(){
    local footprint items line cmd_status
    if [ "${1:-}" = "-l" ] || [ "${1:-}" = "--list" ] || ! ui_interactive; then
        _ohmytool_list
        return 0
    fi

    items=()
    while IFS= read -r line; do
        items+=("$line")
    done <<< "$(_ohmytool_categories)"
    items+=("all|Every tool in one searchable list")

    # Cancelling a category menu comes back here: the trail of the category
    # menu is erased and it is drawn again in place.
    while :; do
        ui_menu "ohmytool" "server management & tools catalog" "${items[@]}" || return 1
        footprint=$UI_MENU_FOOTPRINT
        _ohmytool_pick "$UI_CHOICE_NAME"
        cmd_status=$?
        if [ "$UI_CHOICE" -gt 0 ]; then
            return "$cmd_status"
        fi
        ui_menu_erase "$footprint"
    done
}

new_vps_help(){
    ui_heading "New VPS Setup Guide" "recommended sequence for freshly provisioned servers"

    ui_note "Welcome! Here is a recommended sequence to get your server fully configured:"
    ui_gap

    print_step "0" "Install base tools (autojump, fzf, trzsz)"
    ui_command "install_base"
    ui_gap

    print_step "1" "Configure network proxy (if server is in China)"
    ui_command "install_vpn"
    ui_gap

    print_step "2" "Configure SSH security and user accounts"
    ui_command "install_server-administration && myadduser"
    ui_gap

    print_step "3" "Install Docker environment"
    ui_command "install_docker"
    ui_gap

    print_step "4" "Install Nginx Proxy Manager (SSL & reverse proxy)"
    ui_command "install_nginxproxy"
    ui_gap

    ui_rule

    ui_heading "Optional Services & Applications" "install as needed"
    ui_item "install_deepl" "DeepL translation service" 24
    ui_item "install_homeweb" "Personal homepage" 24
    ui_item "install_newtab" "Browser new tab page" 24
    ui_item "install_overleaf" "LaTeX collaboration platform" 24
    ui_item "install_cloudreve" "Private cloud storage" 24
    ui_item "install_serverstatus" "Server status monitoring" 24
    ui_item "install_frp" "Intranet penetration tool" 24
    ui_item "install_chatgpt" "ChatGPT web interface" 24
    ui_item "install_trzsz" "Fast file transfer (trz / tsz)" 24
    ui_item "install_tssh" "SSH client with trzsz support" 24
    ui_item "install_xui" "X-UI VPN panel" 24
    ui_item "install_qbittorrent" "BitTorrent client" 24
    ui_item "install_jellyfin" "Media streaming server" 24
    ui_item "install_image" "Image hosting (lsky-pro)" 24
    ui_item "install_safe_rm" "Safe deletion with trash bin" 24
    ui_item "install_discard_vim" "Remote editing with VS Code / Sublime" 24
    ui_item "install_joshuto" "Modern terminal file browser" 24

    ui_gap
    ui_warn "Remember to configure Nginx proxy ports and SSL certificates after installing web apps!"
    ui_gap
}

install_base() {
    local failed=0 selected="" tool
    ui_choose "install_base" "essential command-line tools" \
        "autojump|Smart directory navigation" \
        "fzf|Command-line fuzzy finder" \
        "trzsz|File transfer with trz / tsz" || return
    if ui_picked 1; then selected="autojump"; fi
    if ui_picked 2; then selected="$selected fzf"; fi
    if ui_picked 3; then selected="$selected trzsz"; fi
    while IFS= read -r tool; do
        [ -z "$tool" ] || gcr_install "$tool" || failed=1
    done <<EOF
$(printf '%s' "$selected" | tr ' ' '\n')
EOF
    if [ "$failed" != 0 ]; then ui_err "some base tools failed to install"; return 1; fi
    ui_ok "selected base tools are installed"
}
