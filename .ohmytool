# Reminde you what to install when you get a new server.
new_vps_help(){
    print_section "New VPS Setup Guide"

    print_text "white" "Welcome! Here's a recommended installation sequence for your new server:"
    printf "\n"

    print_step "Step 0: Install base tools"
    print_info "Run: install_base"
    printf "\n"

    print_step "Step 1: Configure network (if in China)"
    print_info "Run: install_vpn"
    printf "\n"

    print_step "Step 2: Set up SSH security"
    print_info "Run: install_server-administration, then use myadduser"
    printf "\n"

    print_step "Step 3: Install Docker environment"
    print_info "Run: install_docker"
    printf "\n"

    print_step "Step 4: Install Nginx proxy manager"
    print_info "Run: install_nginxproxy"
    printf "\n"

    print_separator

    print_text "cyan" "\nOptional Services:"
    print_item "5" "DeepL translator: install_deepl"
    print_item "6" "Personal homepage: install_homeweb"
    print_item "7" "New tab page: install_newtab"
    print_item "8" "LaTeX editor: install_overleaf"
    print_item "9" "Cloud storage: install_cloudreve"
    print_item "10" "Server monitor: install_serverstatus"
    print_item "11" "Intranet penetration: install_frp"
    print_item "12" "ChatGPT interface: install_chatgpt"
    print_item "13" "File transfer: install_trzsz"
    print_item "14" "SSH client: install_tssh"
    print_item "15" "VPN panel: install_xui"
    print_item "16" "BitTorrent: install_qbittorrent"
    print_item "17" "Media server: install_jellyfin"
    print_item "18" "Image hosting: install_image"
    print_item "19" "Safe deletion: install_safe_rm"
    print_item "20" "Remote editing: install_discard_vim"
    print_item "21" "File browser: install_joshuto"

    printf "\n"
    print_warning "Remember to configure nginx proxy after installation!"
    printf "\n"
}

# =================================== Install plugin=============================================

# Install some base tools.
install_base(){
    print_section "Installing Base Tools"

    print_text "white" "Essential command-line tools to enhance your terminal experience."
    printf "\n"

    if ask_yes_no "Install autojump (smart directory navigation)?" "y"; then
        install_autojump
    fi

    if ask_yes_no "Install fzf (fuzzy finder)?" "y"; then
        install_fzf
    fi

    if ask_yes_no "Install trzsz (file transfer tool)?" "y"; then
        install_trzsz
    fi

    printf "\n"
    print_success "Base tools installation completed!"
}

